  function getMemoryMessages(
    messageList
  ) {
    const instruction =
      memoryInstruction();

    if (
      !instruction ||
      !Array.isArray(
        messageList
      )
    ) {
      return messageList;
    }

    const latestUserIndex =
      [...messageList]
        .map(
          (
            message,
            index
          ) =>
            message?.role ===
            "user"
              ? index
              : -1
        )
        .filter(
          index =>
            index !== -1
        )
        .pop();

    if (
      latestUserIndex ===
        undefined
    ) {
      return messageList;
    }

    return [
      ...messageList.slice(
        0,
        latestUserIndex
      ),
      {
        role: "user",
        content:
          instruction
      },
      ...messageList.slice(
        latestUserIndex
      )
    ];
  }

