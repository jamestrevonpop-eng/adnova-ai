    typeof openAdnovaSettings ===
      "function"
      ? openAdnovaSettings
      : null;

  if (
    oldOpenSettings &&
    !window.__adnovaNextSettingsRefresh
  ) {
    window.__adnovaNextSettingsRefresh =
      true;

    openAdnovaSettings =
      function () {
        oldOpenSettings();

        createMemorySettingsSection();
        createCacheSettingsSection();

