function addMessageActions(
  message,
  bubble,
  conversationIndex
) {
  const existing =
    message.querySelector(
      ".message-actions"
    );

  if (existing) {
    existing.remove();
  }

  if (
    typeof conversationIndex !== "number" ||
    !conversation[conversationIndex]
  ) {
    return;
  }

  const actions =
    document.createElement("div");

  actions.className =
    "message-actions";

  if (
    conversation[conversationIndex].role ===
    "user"
  ) {
    const editButton =
      createActionButton(
