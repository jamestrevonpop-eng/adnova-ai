  function renderProjectWorkspace() {
    const project =
      activeProject();

    if (!project) {
      return;
    }

    const branchSelect =
      document.getElementById(
        "adnova-project-branch-select"
      );

    const projectName =
      document.getElementById(
        "adnova-project-name"
      );

    const projectBranch =
      document.getElementById(
        "adnova-project-branch"
      );

    const chatList =
      document.getElementById(
        "adnova-project-chat-list"
      );

    const messagesArea =
      document.getElementById(
        "adnova-project-chat-messages"
      );

    if (
      projectName
    ) {
      projectName.textContent =
        project.name;
    }

    if (
      projectBranch
    ) {
      projectBranch.textContent =
        `branch · ${
          projectState.branch ||
          "main"
        }`;
    }

    if (
      branchSelect
    ) {
      branchSelect.innerHTML =
        project.branches
          .map(
            branch =>
              `<option value="${escapeAttachmentText(
                branch
              )}">${escapeAttachmentText(
                branch
              )}</option>`
          )
          .join("");

      branchSelect.value =
        projectState.branch;
    }

    if (
      chatList
    ) {
      chatList.innerHTML =
        "";

      const chats =
        project.chats.filter(
          chat =>
            chat.branch ===
            (
              projectState.branch ||
              "main"
            )
        );

      if (!chats.length) {
        chatList.innerHTML = `
          <div class="adnova-project-chat-empty">
            No chats on this branch.
          </div>
        `;
      }

      chats.forEach(
        chat => {
          const button =
            document.createElement(
              "button"
            );

          button.type =
            "button";

          button.className =
            "adnova-project-chat-item";

          if (
            chat.id ===
            projectState.chatId
          ) {
            button.classList.add(
              "active"
            );
          }

          button.textContent =
            chat.title ||
            "Project chat";

          button.addEventListener(
            "click",
            () => {
              projectState.chatId =
                chat.id;

              renderProjectWorkspace();
            }
          );

          chatList.appendChild(
            button
          );
        }
      );
    }

    if (
      messagesArea
    ) {
      messagesArea.innerHTML =
        "";

      const chat =
        activeProjectChat();

      if (
        !chat ||
        !chat.messages.length
      ) {
        messagesArea.innerHTML = `
          <div class="adnova-project-message-empty">
            <strong>Project AI</strong>
            <span>
              Start a conversation in this branch.
            </span>
          </div>
        `;
      } else {
        chat.messages.forEach(
          message => {
            const row =
              document.createElement(
                "div"
              );

            row.className =
              `adnova-project-message ${message.role}`;

            const bubble =
              document.createElement(
                "div"
              );

            bubble.className =
              "adnova-project-message-bubble";

            bubble.innerHTML =
              formatMessage(
                message.content ||
                ""
              );

            row.appendChild(
              bubble
            );

            messagesArea.appendChild(
              row
            );
          }
        );
      }

      requestAnimationFrame(
        () => {
          messagesArea.scrollTop =
            messagesArea.scrollHeight;
        }
      );
    }
  }

  async function sendProjectMessage(
    event
  ) {
    event.preventDefault();

    if (
      projectGenerating
    ) {
      projectController?.abort();
      return;
    }

    const inputEl =
      document.getElementById(
        "adnova-project-input"
      );

    const value =
      String(
        inputEl?.value || ""
      ).trim();

    if (!value) {
      return;
    }

    const project =
      activeProject();

    const chat =
      activeProjectChat();

    if (
      !project ||
      !chat
    ) {
      return;
    }

    projectGenerating =
      true;

    inputEl.value =
      "";

    chat.messages.push({
      role: "user",
      content:
        value
    });

    chat.title =
      chat.messages.filter(
        message =>
          message.role ===
          "user"
      ).length === 1
        ? value.length > 42
          ? `${value.slice(0, 42)}…`
          : value
        : chat.title;

    chat.updatedAt =
      Date.now();

    project.updatedAt =
      Date.now();

    saveProjects();

    renderProjectWorkspace();

    const messagesArea =
      document.getElementById(
        "adnova-project-chat-messages"
      );

    const assistantRow =
      document.createElement(
        "div"
      );

    assistantRow.className =
      "adnova-project-message assistant";

    const assistantBubble =
      document.createElement(
        "div"
      );

    assistantBubble.className =
      "adnova-project-message-bubble";

    assistantBubble.innerHTML =
      "<p>Working…</p>";

    assistantRow.appendChild(
      assistantBubble
    );

    messagesArea.appendChild(
      assistantRow
    );

    projectController =
      new AbortController();

    const context =
      `PROJECT CONTEXT:
Project: ${project.name}
Branch: ${projectState.branch}

This is a dedicated Project conversation. Keep the project and branch context in mind.

${memoryInstruction()}`;

    const requestMessages =
      getMemoryMessages([
        {
          role:
            "user",
          content:
            context
        },
        ...chat.messages
      ]);

    let fullResponse =
      "";

    try {
      const response =
        await fetch(
          "/api/chat/stream",
          {
            method:
              "POST",
            headers: {
              "Content-Type":
                "application/json"
            },
            body:
              JSON.stringify({
                messages:
                  requestMessages,
                aiPreference:
                  getCodeAgentPreference()
              }),
            signal:
              projectController.signal
          }
        );

      if (!response.ok) {
        throw new Error(
          "Project AI could not process that request."
        );
      }

      if (
        !response.body
      ) {
        throw new Error(
          "Streaming is not supported by this browser."
        );
      }

      const reader =
        response.body.getReader();

      const decoder =
        new TextDecoder();

      let buffer =
        "";

      let finished =
        false;

      while (
        !finished
      ) {
        const {
          value,
          done
        } =
          await reader.read();

        if (done) {
          break;
        }

        buffer +=
          decoder.decode(
            value,
            {
              stream:
                true
            }
          );

        const events =
          buffer.split(
            "\n\n"
          );

        buffer =
          events.pop() ||
          "";

        for (
          const eventText of
          events
        ) {
          const line =
            eventText
              .split("\n")
              .find(
                line =>
                  line.startsWith(
                    "data:"
                  )
              );

          if (!line) {
            continue;
          }

          const data =
            line
              .slice(5)
              .trim();

          if (
            data ===
            "[DONE]"
          ) {
            finished =
              true;
            break;
          }

          try {
            const parsed =
              JSON.parse(
                data
              );

            if (
              parsed.error
            ) {
              throw new Error(
                parsed.error
              );
            }

            if (
              typeof parsed.content ===
              "string"
            ) {
              fullResponse +=
                parsed.content;

              assistantBubble.innerHTML =
                formatMessage(
                  fullResponse
                );

              messagesArea.scrollTop =
                messagesArea.scrollHeight;
            }
          } catch (
            error
          ) {
            if (
              error?.message
            ) {
              throw error;
            }
          }
        }
      }

      if (
        fullResponse
      ) {
        chat.messages.push({
          role:
            "assistant",
          content:
            fullResponse
        });

        chat.updatedAt =
          Date.now();

        project.updatedAt =
          Date.now();

        saveProjects();
      }
    } catch (
      error
    ) {
      if (
        error?.name !==
        "AbortError"
      ) {
        assistantBubble.innerHTML =
          formatMessage(
            `Sorry — ${
              error.message ||
              "Project AI failed."
            }`
          );
      }
    } finally {
      projectController =
        null;

      projectGenerating =
        false;

      renderProjectWorkspace();

      document
        .getElementById(
          "adnova-project-input"
        )
        ?.focus();
    }
  }

