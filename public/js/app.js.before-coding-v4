   * ---------------------------------------------------------
   */

  function restoreLatestSnapshot() {
    if (
      typeof studioState ===
        "undefined" ||
      !studioState.snapshots?.length
    ) {
      showAdnovaNotification?.(
        "There is no saved snapshot yet.",
        "error"
      );

      return;
    }

    const snapshot =
      studioState.snapshots[0];

    if (
      !snapshot?.files
    ) {
      return;
    }

    studioState.files =
      JSON.parse(
        JSON.stringify(
          snapshot.files
        )
      );

    studioState.currentFile =
      studioState.files[
        "/index.html"
      ]
        ? "/index.html"
        : Object.keys(
            studioState.files
          )[0] || "/index.html";

    if (
      typeof saveStudioState ===
      "function"
    ) {
      saveStudioState();
    }

    if (
      typeof renderFileTree ===
      "function"
    ) {
      renderFileTree();
    }

    if (
      typeof openStudioFile ===
      "function"
    ) {
      openStudioFile(
        studioState.currentFile
      );
    }

    refreshPreview();

    switchStudioTab?.(
      "preview"
    );

    showAdnovaNotification?.(
      "Latest snapshot restored and Preview refreshed.",
      "success"
    );
  }

  if (
    typeof createSnapshot ===
      "function" &&
    !window.__adnovaStudioSnapshotV3
  ) {
    const originalCreateSnapshot =
      createSnapshot;

    window.__adnovaStudioSnapshotV3 =
      true;

    createSnapshot =
      function () {
        originalCreateSnapshot();

        refreshPreview();

        ensurePreviewControls();

        switchStudioTab?.(
          "preview"
        );
      };
  }

  /*
   * ---------------------------------------------------------
   * AI RESPONSE -> PROJECT FILES
   * ---------------------------------------------------------
   */

  function findFilenameAroundBlock(
    fullText,
    blockStart,
    language
  ) {
    const before =
      fullText
        .slice(
          Math.max(
            0,
            blockStart -
              220
          ),
          blockStart
        )
        .trim();

    const match =
      before.match(
        /(?:^|\n)\s*(?:file\s*:\s*|filename\s*:\s*|###\s*|##\s*|[-*]\s*)?((?:\/|\.\/)?[\w./-]+\.(?:html?|css|js|jsx|ts|tsx|json|md|txt|svg|py|java|c|cpp|cs|php))\s*$/im
      );

    if (
      match?.[1]
    ) {
      let path =
        match[1]
          .trim()
          .replace(
            /^\.\/+/,
            "/"
          );

      if (
        !path.startsWith(
          "/"
        )
      ) {
        path =
          `/${path}`;
      }

      return path;
    }

    const aliases = {
      html:
        "/index.html",
      htm:
        "/index.html",
      css:
        "/style.css",
      javascript:
        "/script.js",
      js:
        "/script.js",
      jsx:
        "/app.jsx",
      typescript:
        "/app.ts",
      ts:
        "/app.ts",
      json:
        "/data.json",
      markdown:
        "/README.md",
      md:
        "/README.md"
    };

    return (
      aliases[
        String(
          language || ""
        )
          .trim()
          .toLowerCase()
      ] ||
      null
    );
  }

  function applyCodingResponseToFiles(
    response
  ) {
    if (
      typeof response !==
        "string" ||
      !response.trim() ||
      typeof studioState ===
        "undefined"
    ) {
      return 0;
    }

    /*
     * Prefer explicit fenced code blocks.
     */

    const pattern =
      /```([A-Za-z0-9_+#.-]*)[ \t]*\n([\s\S]*?)```/g;

    const matches =
      [];

    let match;

    while (
      (match =
        pattern.exec(
          response
        ))
    ) {
      matches.push({
        language:
          match[1] || "",
        code:
          match[2] || "",
        start:
          match.index
      });
    }

    let applied =
      0;

    for (
      const block of
      matches
    ) {
      const language =
        block.language
          .toLowerCase()
          .trim();

      let filename =
        findFilenameAroundBlock(
          response,
          block.start,
          language
        );

      /*
       * Avoid mapping several unnamed JS blocks
       * onto the same file.
       */

      if (
        !filename
      ) {
        if (
          language ===
            "js" ||
          language ===
            "javascript"
        ) {
          filename =
            applied === 0
              ? "/script.js"
              : `/script-${applied}.js`;
        } else if (
          language ===
            "css"
        ) {
          filename =
            applied === 0
              ? "/style.css"
              : `/style-${applied}.css`;
        } else if (
          language ===
            "html" ||
          language ===
            "htm"
        ) {
          filename =
            applied === 0
              ? "/index.html"
              : `/page-${applied}.html`;
        } else {
          continue;
        }
      }

      if (
        block.code.trim()
      ) {
        const parent =
          parentPath(
            filename
          );

        if (
          parent &&
          !exists(
            parent
          )
        ) {
          addFolder(
            parent
          );
        }

        studioState.files[
          filename
        ] = {
          type:
            "file",
          content:
            block.code.trimEnd()
        };

        applied +=
          1;
      }
    }

    /*
     * Fallback: if the AI returned a raw full HTML
     * document without fences, make it the page.
     */

    if (
      applied === 0 &&
      (
        /<!doctype\s+html/i.test(
          response
        ) ||
        /<html[\s>]/i.test(
          response
        )
      )
    ) {
      studioState.files[
        "/index.html"
      ] = {
        type:
          "file",
        content:
          response.trim()
      };

      applied =
        1;
    }

    if (
      applied > 0
    ) {
      studioState.currentFile =
        studioState.files[
          "/index.html"
        ]
          ? "/index.html"
          : Object.keys(
              studioState.files
            )[0];

      saveStudioState();

      renderFileTree();
      openStudioFile(
        studioState.currentFile
      );

      refreshPreview();

      ensurePreviewControls();

      switchStudioTab?.(
        "build"
      );

      showAdnovaNotification?.(
        `${applied} project file${
          applied === 1
            ? ""
            : "s"
        } updated from the AI response.`,
        "success"
      );
    }

    return applied;
  }

  /*
   * ---------------------------------------------------------
   * AUTOMATIC CODING APPLY
   * ---------------------------------------------------------
   */

  if (
    typeof sendMessage ===
      "function" &&
    !window.__adnovaCodingAutoApply
  ) {
    const originalSendMessage =
      sendMessage;

    window.__adnovaCodingAutoApply =
      true;

    sendMessage =
      async function () {
        const wasCoding =
          currentMode ===
          "coding";

        const result =
          await originalSendMessage();

        if (
          wasCoding
        ) {
          const response =
            typeof getLatestCodingResponse ===
            "function"
              ? getLatestCodingResponse()
              : "";

          if (
            response
          ) {
            createStudio();

            applyCodingResponseToFiles(
              response
            );

            ensurePreviewControls();
          }
        }

        return result;
      };
  }

  /*
   * ---------------------------------------------------------
   * CLEAN CODING UI
   * ---------------------------------------------------------
   */

  function refreshCodingStudioUI() {
    removeLegacyTerminal();

    ensureCodingResetButton();

    if (
      document.getElementById(
        "adnova-coding-studio"
      )
    ) {
      ensurePreviewControls();

      if (
        typeof refreshPreview ===
        "function"
      ) {
        refreshPreview();
      }
    }
  }

  refreshCodingStudioUI();

  const observer =
    new MutationObserver(
      () => {
        if (
          currentMode ===
          "coding"
        ) {
          removeLegacyTerminal();
          ensureCodingResetButton();

          if (
            document.getElementById(
              "adnova-coding-studio"
            )
          ) {
            ensurePreviewControls();
          }
        }
      }
    );

  observer.observe(
    document.body,
    {
      childList:
        true,
      subtree:
        true
    }
  );

  /*
   * ---------------------------------------------------------
   * 10 GB LIVE WORKSPACE STORAGE
   * ---------------------------------------------------------
   */

  async function calculateAdnovaWorkspaceBytes() {
    let total =
      0;

    try {
      const keys =
        Object.keys(
          localStorage
        );

      for (
        const key of
        keys
      ) {
        if (
          !key.startsWith(
            "adnova_"
          )
        ) {
          continue;
        }

        const value =
          localStorage.getItem(
            key
          ) || "";

        total +=
          (
            key.length +
            value.length
          ) *
          2;
      }
    } catch {}

    return total;
  }

  async function renderAdnovaWorkspaceStorage() {
    const used =
      document.getElementById(
        "adnova-workspace-used"
      );

    const free =
      document.getElementById(
        "adnova-workspace-free"
      );

    const bar =
      document.getElementById(
        "adnova-workspace-bar"
      );

    const updated =
      document.getElementById(
        "adnova-workspace-updated"
      );

    if (
      !used ||
      !free ||
      !bar ||
      !updated
    ) {
      return;
    }

    const bytes =
      await calculateAdnovaWorkspaceBytes();

    const freeBytes =
      Math.max(
        ADNOVA_WORKSPACE_ALLOWANCE -
          bytes,
        0
      );

    const percentage =
      Math.min(
        (
          bytes /
          ADNOVA_WORKSPACE_ALLOWANCE
        ) *
          100,
        100
      );

    used.textContent =
      formatStorageBytes(
        bytes
      );

    free.textContent =
      formatStorageBytes(
        freeBytes
      );

    bar.style.width =
      `${percentage}%`;

    updated.textContent =
      `Live · ${new Date().toLocaleTimeString(
        [],
        {
          hour:
            "2-digit",
          minute:
            "2-digit",
          second:
            "2-digit"
        }
      )}`;
  }

  function createWorkspaceStorageSection() {
    const body =
      document.querySelector(
        "#adnova-settings-panel .adnova-settings-body"
      );

    if (
      !body ||
      document.getElementById(
        "adnova-workspace-storage-section"
      )
    ) {
      return;
    }

    const section =
      document.createElement(
        "section"
      );

    section.id =
      "adnova-workspace-storage-section";

    section.className =
      "adnova-settings-section";

    section.innerHTML = `
      <div class="adnova-settings-section-title">
        Adnova workspace storage
      </div>

      <div class="adnova-storage-card">

        <div class="adnova-storage-row">

          <div>
            <strong>
              10 GB workspace allowance
            </strong>

            <span>
              Live estimate of Adnova-managed local project data.
            </span>
          </div>

          <strong>
            10 GB
          </strong>

        </div>

        <div class="adnova-storage-bar">

          <div
            id="adnova-workspace-bar"
            class="adnova-storage-bar-fill"
          ></div>

        </div>

        <div class="adnova-storage-values">

          <span>
            Used
            <strong id="adnova-workspace-used">
              —
            </strong>
          </span>

          <span>
            Remaining
            <strong id="adnova-workspace-free">
              —
            </strong>
          </span>

        </div>

        <div
          id="adnova-workspace-updated"
          class="adnova-live-storage-time"
        >
          Checking…
        </div>

      </div>
    `;

    body.appendChild(
      section
    );

    renderAdnovaWorkspaceStorage();
  }

  createWorkspaceStorageSection();

  setInterval(
    () => {
      refreshCacheWindow?.();

      renderLiveCachePanel?.();

      renderAdnovaWorkspaceStorage();

      if (
        currentMode ===
        "coding"
      ) {
        ensureCodingResetButton();
        removeLegacyTerminal();
      }
    },
    1000
  );
})();
