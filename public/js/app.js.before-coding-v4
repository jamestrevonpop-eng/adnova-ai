  function updateProjectsButtonState() {
    const button =
      document.getElementById(
        "adnova-projects-button"
      );

    if (!button) {
      return;
    }

    const enabled =
      projectsAllowed();

    button.disabled =
      !enabled;

    button.classList.toggle(
      "disabled",
      !enabled
    );

    button.title =
      enabled
        ? "Open Projects"
        : "Enable Auto-save and Save history to use Projects";
  }

  ensureProjectsButton();
  updateProjectsButtonState();

  /*
   * ---------------------------------------------------------
   * PROJECTS FOLLOW THE HISTORY SETTINGS
   * ---------------------------------------------------------
   */

  if (
    typeof setAdnovaSetting ===
      "function" &&
    !window.__adnovaProjectsSettingWrap
  ) {
    const originalSetSetting =
      setAdnovaSetting;

    window.__adnovaProjectsSettingWrap =
      true;

    setAdnovaSetting =
      function (
        key,
        value
      ) {
        const result =
          originalSetSetting(
            key,
            value
          );

        updateProjectsButtonState();

        if (
          (
            key ===
