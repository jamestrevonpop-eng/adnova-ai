}

const adnovaOriginalSetCurrentMode =
  setCurrentMode;

setCurrentMode =
  function (mode) {
    adnovaOriginalSetCurrentMode(mode);
    updateNewChatControlsForMode();
  };


/* =========================================================
   ADNOVA SETTINGS / LOCAL DATA
   ========================================================= */

function loadAdnovaSettings() {
  try {
    const stored =
      localStorage.getItem(
        ADNOVA_SETTINGS_KEY
      );

    const parsed =
      stored
        ? JSON.parse(stored)
        : {};

    adnovaSettings = {
      ...DEFAULT_ADNOVA_SETTINGS,
      ...(parsed && typeof parsed === "object"
        ? parsed
        : {})
    };

    adnovaSettings.codeAgentPreference =
      String(
        adnovaSettings.codeAgentPreference || ""
      )
        .trim()
        .slice(0, 4000);
  } catch {
    adnovaSettings = {
      ...DEFAULT_ADNOVA_SETTINGS
    };
  }
}

function persistAdnovaSettings() {
  try {
    localStorage.setItem(
      ADNOVA_SETTINGS_KEY,
      JSON.stringify(adnovaSettings)
    );
  } catch (error) {
    console.error(
      "Could not save Adnova settings:",
      error
    );
  }
}

function formatStorageBytes(bytes) {
  const value =
    Number(bytes) || 0;

  if (value < 1024) {
    return `${value} B`;
  }

  if (value < 1024 * 1024) {
    return `${(
      value / 1024
    ).toFixed(1)} KB`;
  }

  if (value < 1024 * 1024 * 1024) {
    return `${(
      value /
      (1024 * 1024)
    ).toFixed(1)} MB`;
  }

  return `${(
    value /
    (1024 * 1024 * 1024)
  ).toFixed(2)} GB`;
}

function clearSavedConversationHistory() {
  chatHistory = [];
  codingHistory = [];
  codingConversation = [];
  currentChatId = null;

  try {
    localStorage.removeItem(
      CHAT_HISTORY_KEY
    );

    localStorage.removeItem(
      CODING_HISTORY_KEY
    );
  } catch {}

  renderChatHistory();

  if (
    typeof renderCodingHistory ===
    "function"
  ) {
    renderCodingHistory();
  }
}

function applyAdnovaSettingsUI() {
  document.body.classList.toggle(
    "adnova-compact-interface",
    !!adnovaSettings.compactInterface
  );

  document.body.classList.toggle(
    "adnova-reduced-motion",
    !!adnovaSettings.reducedMotion
  );

  document.body.classList.toggle(
    "adnova-hide-mode-badge",
    !adnovaSettings.showModeBadge
  );

  const autoSave =
    document.getElementById(
      "adnova-setting-auto-save"
    );

  const saveHistory =
    document.getElementById(
      "adnova-setting-save-history"
    );

  const modeBadge =
    document.getElementById(
      "adnova-setting-mode-badge"
    );

  const compact =
    document.getElementById(
      "adnova-setting-compact"
    );

  const motion =
    document.getElementById(
      "adnova-setting-motion"
    );

  const codeAgent =
    document.getElementById(
      "adnova-code-agent-preference"
    );

  if (autoSave) {
    autoSave.checked =
      !!adnovaSettings.autoSave;
  }

  if (saveHistory) {
    saveHistory.checked =
      !!adnovaSettings.saveHistory;
  }

  if (modeBadge) {
    modeBadge.checked =
      !!adnovaSettings.showModeBadge;
  }

  if (compact) {
    compact.checked =
      !!adnovaSettings.compactInterface;
  }

  if (motion) {
    motion.checked =
      !!adnovaSettings.reducedMotion;
  }

  if (
    codeAgent &&
    codeAgent.value !==
      adnovaSettings.codeAgentPreference
  ) {
    codeAgent.value =
      adnovaSettings.codeAgentPreference;
  }
}

function setAdnovaSetting(
  key,
  value
) {
  if (
    !Object.prototype.hasOwnProperty.call(
      DEFAULT_ADNOVA_SETTINGS,
      key
    )
  ) {
    return;
  }

  if (
    key === "codeAgentPreference"
  ) {
    value =
      String(value || "")
        .trim()
        .slice(0, 4000);
  }

  adnovaSettings[key] =
    value;

  if (
    key === "saveHistory" &&
    !adnovaSettings.saveHistory
  ) {
    clearSavedConversationHistory();
  }

  if (
    key === "autoSave" &&
    !adnovaSettings.autoSave
  ) {
    clearSavedConversationHistory();
  }

  persistAdnovaSettings();
  applyAdnovaSettingsUI();
  refreshAdnovaStorageStats();
}

async function refreshAdnovaStorageStats() {
  const used =
    document.getElementById(
      "adnova-storage-used"
    );

  const free =
    document.getElementById(
      "adnova-storage-free"
    );

  const bar =
    document.getElementById(
      "adnova-storage-bar"
    );

  const meta =
    document.getElementById(
      "adnova-storage-meta"
    );

  if (
    !used ||
    !free ||
    !bar ||
    !meta
  ) {
    return;
  }

  if (
    !navigator.storage ||
    typeof navigator.storage.estimate !==
      "function"
  ) {
    used.textContent = "Unknown";
    free.textContent = "Unknown";
    bar.style.width = "0%";
    meta.textContent =
      "This browser does not expose a storage estimate.";
    return;
  }

  try {
    const estimate =
      await navigator.storage.estimate();

    const usage =
      Number(estimate.usage) || 0;

    const quota =
      Number(estimate.quota) || 0;

    const available =
      Math.max(
        quota - usage,
        0
      );

    const percent =
      quota > 0
        ? Math.min(
            (usage / quota) * 100,
            100
          )
        : 0;

    used.textContent =
      formatStorageBytes(
        usage
      );

    free.textContent =
      formatStorageBytes(
        available
      );

    bar.style.width =
      `${percent}%`;

    meta.textContent =
      quota > 0
        ? `Estimated site storage: ${formatStorageBytes(
            quota
          )} total`
        : "Storage quota estimate unavailable.";
  } catch {
    used.textContent = "Unknown";
    free.textContent = "Unknown";
    bar.style.width = "0%";
    meta.textContent =
      "Could not read browser storage usage.";
  }
}

async function eraseAllAdnovaData() {
  const confirmed =
    window.confirm(
      "Erase Adnova's saved chats, Coding sessions, settings and local Adnova cache from this browser?"
    );

  if (!confirmed) {
    return;
  }

  try {
    const localKeys = [];

    for (
      let i = 0;
      i < localStorage.length;
      i++
    ) {
      const key =
        localStorage.key(i);

      if (
        key &&
        key.startsWith("adnova_")
      ) {
        localKeys.push(key);
      }
    }

    localKeys.forEach(
      key =>
        localStorage.removeItem(key)
    );

    const sessionKeys = [];

    for (
      let i = 0;
      i < sessionStorage.length;
      i++
    ) {
      const key =
        sessionStorage.key(i);

      if (
        key &&
        key.startsWith("adnova_")
      ) {
        sessionKeys.push(key);
      }
    }

    sessionKeys.forEach(
      key =>
        sessionStorage.removeItem(key)
    );

    if (
      typeof caches !==
      "undefined"
    ) {
      const names =
        await caches.keys();

      await Promise.all(
        names
          .filter(name =>
            name.startsWith("adnova")
          )
          .map(name =>
            caches.delete(name)
          )
      );
    }
  } catch (error) {
    console.error(
      "Could not erase Adnova data:",
      error
    );
  }

  adnovaSettings = {
    ...DEFAULT_ADNOVA_SETTINGS
  };

  chatHistory = [];
  codingHistory = [];
  codingConversation = [];
  conversation = [];
  currentChatId = null;

  messages.innerHTML = "";

  welcome.classList.remove(
    "hidden"
  );

  clearAttachments();

  input.value = "";

  resizeInput();

  applyAdnovaSettingsUI();
  renderChatHistory();

  if (
    typeof renderCodingHistory ===
    "function"
  ) {
    renderCodingHistory();
  }

  refreshAdnovaStorageStats();
}

function closeAdnovaSettings() {
  document
    .getElementById(
