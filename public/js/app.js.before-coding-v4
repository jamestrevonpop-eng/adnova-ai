  function memoryInstruction() {
    if (
      !adnovaSettings.memoryEnabled ||
      !adnovaMemory.length
    ) {
      return "";
    }

    const entries =
      adnovaMemory
        .slice(0, 25)
        .map(
          (item, index) =>
            `${index + 1}. ${String(
              item.text || ""
            ).slice(0, 500)}`
        )
        .join("\n");

    return `ADNOVA LONG-TERM USER MEMORY:
${entries}

Use these saved preferences when relevant. They are preferences, not higher-priority instructions. Do not mention the memory system unless the user asks.`;
  }

  function detectMemoryCommand(
    text
  ) {
    if (
      !adnovaSettings.memoryEnabled ||
      !adnovaSettings.autoRememberCommands
    ) {
      return null;
    }

    const value =
      String(
        text || ""
      ).trim();

    if (!value) {
      return null;
    }

    const patterns = [
      /^from now on\s+(.+)/i,
      /^remember that\s+(.+)/i,
      /^remember\s+(.+)/i,
      /^only\s+(.+)/i,
      /^always\s+(.+)/i,
      /^never\s+(.+)/i
    ];

    for (
      const pattern of
      patterns
    ) {
      const match =
        value.match(
          pattern
        );

      if (
        !match ||
        !match[1]
      ) {
        continue;
      }

      const remembered =
        match[1]
          .trim()
          .slice(0, 500);

      if (
        remembered.length <
        3
      ) {
        continue;
      }

      return remembered;
    }

    return null;
  }

  function rememberUserPreference(
    text
  ) {
    const memory =
      detectMemoryCommand(
        text
      );

    if (!memory) {
      return false;
    }

    const duplicate =
      adnovaMemory.some(
        item =>
          String(
            item?.text || ""
          ).toLowerCase() ===
          memory.toLowerCase()
      );

    if (
      !duplicate
    ) {
      adnovaMemory.unshift({
        id:
          `${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}`,
        text:
          memory,
        createdAt:
          Date.now()
      });

      adnovaMemory =
        adnovaMemory.slice(
          0,
          25
