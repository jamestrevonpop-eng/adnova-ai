  function normalizePath(
    value
  ) {
    let path =
      String(
        value || ""
      )
        .trim()
        .replace(
          /\/+/g,
          "/"
        );

    if (
      !path.startsWith("/")
    ) {
      path =
        `/${path}`;
    }

    path =
      path.replace(
        /\/$/,
        ""
      );

    return path || "/";
  }

  function fileName(
    path
  ) {
    const normalized =
      normalizePath(path);

    if (
      normalized === "/"
    ) {
      return "/";
    }

    const parts =
      normalized
        .split("/")
        .filter(Boolean);

    return (
      parts[
        parts.length - 1
      ] || "/"
    );
  }

  function parentPath(
    path
  ) {
    const normalized =
      normalizePath(path);

    if (
      normalized === "/"
    ) {
      return null;
    }

    const parts =
      normalized
        .split("/")
        .filter(Boolean);

    parts.pop();

    return parts.length
      ? `/${parts.join("/")}`
      : "/";
  }

  function exists(
    path
  ) {
    return !!studioState.files[
      normalizePath(path)
    ];
  }

  function childrenOf(
    directory
  ) {
    const parent =
      normalizePath(
        directory
      );

    const prefix =
      parent === "/"
        ? "/"
        : `${parent}/`;

    return Object.entries(
      studioState.files
    )
      .filter(
        ([path]) => {
          if (
            !path.startsWith(
              prefix
            ) ||
            path === parent
          ) {
            return false;
          }

          const rest =
            path.slice(
              prefix.length
            );

          return (
            rest.length > 0 &&
            !rest.includes("/")
          );
        }
      )
      .map(
        ([path, item]) => ({
          path,
          ...item
        })
      )
      .sort(
        (a, b) => {
          if (
            a.type !==
            b.type
          ) {
            return (
              a.type ===
              "folder"
                ? -1
                : 1
            );
          }

          return fileName(
            a.path
          ).localeCompare(
            fileName(
              b.path
            )
          );
        }
      );
  }

  function addFile(
    path,
    content = ""
  ) {
    const normalized =
      normalizePath(
        path
      );

    if (
      normalized ===
      "/"
    ) {
      return false;
    }

    if (
      exists(
        normalized
      )
    ) {
      return false;
    }

    const parent =
      parentPath(
        normalized
      );

    if (
      parent &&
      !exists(
        parent
      )
    ) {
      addFolder(
        parent
      );
    }

    studioState.files[
      normalized
    ] = {
      type:
        "file",
      content:
        String(
          content || ""
        )
    };

    saveStudioState();

    return true;
  }

  function addFolder(
    path
  ) {
    const normalized =
      normalizePath(
        path
      );

    if (
      normalized ===
      "/" ||
      exists(
        normalized
      )
    ) {
      return false;
    }

    const parent =
      parentPath(
        normalized
      );

    if (
      parent &&
      !exists(
        parent
      )
    ) {
      addFolder(
        parent
      );
    }

    studioState.files[
      normalized
    ] = {
      type:
        "folder"
    };

    saveStudioState();

    return true;
  }

  function removePath(
    path
  ) {
    const normalized =
      normalizePath(
        path
