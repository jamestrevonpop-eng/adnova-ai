            localStorage.length;
            i++
          ) {
            const key =
              localStorage.key(i);

            if (
              key &&
              key.startsWith(
                "adnova_"
              )
            ) {
              localKeys.push(
                key
              );
            }
          }

          localKeys.forEach(
            key =>
              localStorage.removeItem(
                key
              )
          );

          const sessionKeys =
            [];

          for (
            let i = 0;
            i <
            sessionStorage.length;
            i++
          ) {
            const key =
              sessionStorage.key(
                i
              );

            if (
              key &&
              key.startsWith(
                "adnova_"
              )
            ) {
              sessionKeys.push(
                key
              );
            }
          }

          sessionKeys.forEach(
            key =>
              sessionStorage.removeItem(
                key
              )
          );

          if (
            typeof caches !==
            "undefined"
          ) {
            const names =
              await caches.keys();

            await Promise.all(
              names
                .filter(
                  name =>
                    name.startsWith(
                      "adnova"
                    )
                )
                .map(
                  name =>
                    caches.delete(
                      name
                    )
                )
            );
          }
