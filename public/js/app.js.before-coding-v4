      );

    const resets =
      document.getElementById(
        "adnova-cache-resets-left"
      );

    const timer =
      document.getElementById(
        "adnova-cache-reset-timer"
      );

    const capacity =
      document.getElementById(
        "adnova-cache-capacity"
      );

    if (
      !used ||
      !free ||
      !bar ||
      !resets ||
      !timer ||
      !capacity
    ) {
      return;
    }

    const stats =
      await getAdnovaLiveCacheStats();

    used.textContent =
      formatStorageBytes(
        stats.bytes
      );

    free.textContent =
      formatStorageBytes(
        Math.max(
          stats.capacity -
            stats.bytes,
          0
        )
      );

    capacity.textContent =
      formatStorageBytes(
        stats.capacity
      );

    bar.style.width =
      `${stats.usedPercent}%`;

    resets.textContent =
      `${stats.remainingResets} / ${CACHE_RESETS_PER_DAY}`;

    const remaining =
      Math.max(
        stats.nextResetAt -
          Date.now(),
        0
      );

    const hours =
      Math.floor(
        remaining /
          (60 * 60 * 1000)
      );

    const minutes =
      Math.floor(
        (remaining %
          (60 * 60 * 1000)) /
          (60 * 1000)
      );

    const seconds =
      Math.floor(
        (remaining %
          (60 * 1000)) /
          1000
      );

    timer.textContent =
      remaining <= 0
        ? "Reset available now"
        : `Allowance refreshes in ${hours}h ${minutes}m ${seconds}s`;

    return stats;
  }

