  function openProjectsPage() {
    if (
      !projectsAllowed()
    ) {
      showAdnovaNotification?.(
        "Projects need Auto-save and Save history enabled.",
        "error"
      );

      return;
    }

    createProjectsPage();

    document
      .getElementById(
        "adnova-settings-panel"
      )
      ?.classList.remove(
        "open"
      );

    document
      .getElementById(
        "chat-history-sidebar"
      )
      ?.classList.remove(
        "open"
      );

    projectsPage.classList.add(
      "open"
    );

    renderProjects();
  }

  function closeProjectsPage() {
    projectController?.abort();
    projectController =
      null;

    projectGenerating =
      false;

    projectsPage?.classList.remove(
      "open"
    );
  }

  function openProjectCreator() {
    if (
      adnovaProjects.length >=
      5
    ) {
      showAdnovaNotification?.(
        "You can have a maximum of 5 projects.",
        "error"
      );

      return;
    }

    const workspace =
      document.getElementById(
        "adnova-project-workspace"
      );

    const empty =
      document.getElementById(
        "adnova-project-empty"
      );

    if (
      !workspace ||
      !empty
    ) {
      return;
    }

    empty.innerHTML = `
      <div class="adnova-project-create">

        <div class="adnova-project-empty-icon">
          ◆
        </div>

        <h2>New project</h2>

        <p>
