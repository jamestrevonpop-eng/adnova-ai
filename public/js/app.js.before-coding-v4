      };
  }

  /*
   * ---------------------------------------------------------
   * GUARANTEE ONLY ONE NEW CHAT BUTTON
   * ---------------------------------------------------------
   */

  function normalizeNewChatButtons() {
    const buttons =
      Array.from(
        document.querySelectorAll(
          ".new-chat-button"
        )
      );

    if (
      buttons.length <= 1
    ) {
      if (
        buttons.length ===
        1
      ) {
        const button =
          buttons[0];

        button.style.left =
          "auto";

        button.style.right =
          "18px";

        button.style.top =
          "18px";
      }

      return;
    }

    /*
     * Keep the rightmost button.
     * This also handles duplicate IDs because we work
     * directly from the DOM rather than getElementById().
     */

    let keeper =
      buttons[buttons.length - 1];

    let rightmost =
      -Infinity;

    buttons.forEach(
      button => {
        const rect =
          button.getBoundingClientRect();

        if (
          rect.right >
          rightmost
        ) {
          rightmost =
            rect.right;

          keeper =
            button;
        }
      }
    );

    buttons.forEach(
      button => {
        if (
          button !==
          keeper
        ) {
          button.remove();
        }
      }
    );

    keeper.style.left =
      "auto";

    keeper.style.right =
      "18px";

    keeper.style.top =
      "18px";

    keeper.style.display =
      "block";
  }

