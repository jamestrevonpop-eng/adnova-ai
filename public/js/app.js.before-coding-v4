  function createProject() {
    const name =
      document.getElementById(
        "adnova-project-create-name"
      )?.value.trim();

    const branch =
      (
        document.getElementById(
          "adnova-project-create-branch"
        )?.value.trim() ||
        "main"
      )
        .replace(
          /\s+/g,
          "-"
        )
        .slice(
          0,
          40
        );

    if (!name) {
      showAdnovaNotification?.(
        "Give the project a name first.",
        "error"
      );

      return;
    }

    const project =
      createProjectRecord(
        name,
        branch
      );

    adnovaProjects.unshift(
      project
    );

    adnovaProjects =
      adnovaProjects.slice(
        0,
        5
      );

    const chat =
      ensureProjectChat(
        project,
        branch
      );

    projectState = {
      projectId:
        project.id,
      chatId:
        chat.id,
      branch
    };

    saveProjects();

    showAdnovaNotification?.(
      `Project "${project.name}" created.`,
      "success"
    );

    renderProjects();
  }

  async function deleteActiveProject() {
    const project =
      activeProject();

    if (!project) {
      return;
    }

    const confirmed =
      typeof adnovaSettings.confirmProjectDeletion ===
        "boolean" &&
      adnovaSettings.confirmProjectDeletion
        ? await adnovaConfirm?.(
            "Delete project?",
            `This removes the local project "${project.name}" and all of its saved chats.`
          )
        : true;

    if (
      confirmed === false
    ) {
      return;
    }

    adnovaProjects =
      adnovaProjects.filter(
        item =>
          item.id !==
          project.id
      );

    projectState = {
      projectId:
        null,
      chatId:
        null,
      branch:
        "main"
    };

    saveProjects();

    showAdnovaNotification?.(
      "Project deleted.",
      "success"
    );

    renderProjects();
  }

  function createProjectChat() {
    const project =
      activeProject();

    if (!project) {
      return;
    }

    const chat =
      {
        id:
          `${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}`,

        title:
          "New project chat",

        branch:
          projectState.branch ||
          "main",

        createdAt:
          Date.now(),

        updatedAt:
          Date.now(),

        messages: []
      };

    project.chats.unshift(
      chat
    );

    projectState.chatId =
      chat.id;

    project.updatedAt =
      Date.now();

    saveProjects();

    renderProjectWorkspace();

    document
      .getElementById(
        "adnova-project-input"
      )
      ?.focus();
  }

  function addProjectBranch() {
    const project =
      activeProject();

    if (!project) {
      return;
    }

    const select =
      document.getElementById(
        "adnova-project-branch-select"
      );

    const wrapper =
      select?.parentElement;

    if (
      !wrapper ||
      document.getElementById(
        "adnova-project-new-branch"
      )
    ) {
      return;
    }

    const input =
      document.createElement(
        "input"
      );

    input.id =
      "adnova-project-new-branch";

    input.className =
      "adnova-project-new-branch";

    input.placeholder =
      "branch-name";

    wrapper.appendChild(
      input
    );

    input.focus();

    function finish() {
      const value =
        input.value
          .trim()
          .replace(
            /\s+/g,
            "-"
          )
          .slice(
            0,
            40
          );

      input.remove();

      if (!value) {
        return;
      }

      if (
        project.branches.includes(
          value
        )
      ) {
        showAdnovaNotification?.(
          "That branch already exists.",
          "error"
        );

        return;
      }

      project.branches.push(
        value
      );

      projectState.branch =
        value;

      ensureProjectChat(
        project,
        value
      );

      project.updatedAt =
        Date.now();

      saveProjects();

      renderProjectWorkspace();

      showAdnovaNotification?.(
        `Branch "${value}" created.`,
        "success"
      );
    }

    input.addEventListener(
      "keydown",
      event => {
        if (
          event.key ===
          "Enter"
        ) {
          event.preventDefault();
          finish();
        }

        if (
          event.key ===
          "Escape"
        ) {
          input.remove();
        }
      }
    );

    input.addEventListener(
      "blur",
      finish
    );
  }

