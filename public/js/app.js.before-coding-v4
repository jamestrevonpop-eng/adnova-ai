    try {
      if (
        typeof caches !==
        "undefined"
      ) {
        const names =
          await caches.keys();

        await Promise.all(
          names
            .filter(
              name =>
                name.startsWith(
                  "adnova"
                )
            )
            .map(
              name =>
                caches.delete(
