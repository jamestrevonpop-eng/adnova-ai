   */

  let terminalFiles = {
    "/": {
      type: "folder"
    }
  };

  let terminalHistory =
    [];

  function terminalPathExists(
    path
  ) {
    return !!terminalFiles[
      path
    ];
  }

  function terminalNormalizePath(
    value
  ) {
    let path =
      String(
        value || ""
      ).trim();

    if (
      !path
    ) {
      return "/";
    }

    if (
      !path.startsWith(
        "/"
      )
    ) {
      path =
        `/${path}`;
    }

    path =
      path
        .replace(
          /\/+/g,
          "/"
        )
        .replace(
          /\/$/,
          ""
        );

    return (
      path || "/"
    );
  }

  function terminalParent(
    path
  ) {
    const normalized =
      terminalNormalizePath(
        path
      );

    if (
      normalized ===
      "/"
    ) {
      return null;
    }

    const parts =
      normalized
        .split(
          "/"
        )
        .filter(Boolean);

    parts.pop();

    return parts.length
      ? `/${parts.join("/")}`
      : "/";
  }

  function terminalName(
    path
  ) {
    const normalized =
      terminalNormalizePath(
        path
      );

    if (
      normalized ===
      "/"
    ) {
      return "/";
    }

    const parts =
      normalized
        .split("/")
        .filter(Boolean);

    return (
      parts[
        parts.length - 1
      ] || "/"
    );
  }

  function terminalChildren(
    directory
  ) {
    const normalized =
      terminalNormalizePath(
        directory
      );

    const prefix =
      normalized ===
      "/"
        ? "/"
        : `${normalized}/`;

    return Object.entries(
      terminalFiles
    )
      .filter(
        ([path]) => {
          if (
            path ===
            normalized ||
            !path.startsWith(
              prefix
            )
          ) {
            return false;
          }

          const rest =
            path.slice(
              prefix.length
            );

          return (
            rest.length >
              0 &&
            !rest.includes(
              "/"
            )
          );
        }
      )
      .map(
        ([path, item]) => ({
          path,
          ...item
        })
      )
      .sort(
        (a, b) =>
          Number(
            b.type ===
              "folder"
          ) -
            Number(
              a.type ===
                "folder"
            ) ||
          terminalName(
            a.path
          ).localeCompare(
            terminalName(
              b.path
            )
          )
      );
  }

  function terminalAddFile(
    path,
    content = ""
  ) {
    const normalized =
      terminalNormalizePath(
        path
      );

    const parent =
      terminalParent(
        normalized
      );

    if (
      !parent ||
      !terminalPathExists(
        parent
      ) ||
      terminalFiles[parent].type !==
        "folder"
    ) {
      return false;
    }

    terminalFiles[
      normalized
    ] = {
      type:
        "file",
      content:
        String(
          content || ""
        )
    };

    return true;
  }

  function terminalAddFolder(
    path
  ) {
    const normalized =
      terminalNormalizePath(
        path
      );

    const parent =
      terminalParent(
        normalized
      );

    if (
      terminalPathExists(
        normalized
      )
    ) {
      return false;
    }

    if (
      parent &&
      (
        !terminalPathExists(
          parent
        ) ||
        terminalFiles[parent].type !==
          "folder"
      )
    ) {
      return false;
    }

    terminalFiles[
      normalized
    ] = {
      type:
        "folder"
    };

    return true;
  }

  function runVirtualTerminalCommand(
    command
  ) {
    const raw =
      String(
        command || ""
      ).trim();

    if (
      !raw
    ) {
      return "";
    }

    const [name, ...args] =
      raw.split(
        /\s+/
      );

    const argument =
      args.join(
        " "
      );

    if (
      name ===
      "help"
    ) {
      return [
        "Available safe workspace commands:",
        "help",
        "pwd",
        "ls [path]",
        "tree [path]",
        "cat <file>",
        "echo <text>",
        "mkdir <folder>",
        "touch <file>",
        "clear",
        "git status",
        "git branch",
        "git checkout <branch>"
      ].join(
        "\n"
      );
    }

    if (
      name ===
      "clear"
    ) {
      return "__CLEAR__";
    }

    if (
      name ===
      "pwd"
    ) {
      return "/";
    }

    if (
      name ===
      "ls"
    ) {
      const path =
        terminalNormalizePath(
          argument
        );

      if (
        !terminalPathExists(
          path
        ) ||
        terminalFiles[path].type !==
          "folder"
      ) {
        return `ls: cannot access '${path}'`;
      }

      const children =
        terminalChildren(
          path
        );

      return children.length
        ? children
            .map(
              item =>
                item.type ===
                "folder"
                  ? `${terminalName(
                      item.path
                    )}/`
                  : terminalName(
                      item.path
                    )
            )
            .join("\n")
        : "";
    }

    if (
      name ===
      "tree"
    ) {
      const path =
        terminalNormalizePath(
          argument
        );

      if (
        !terminalPathExists(
          path
        ) ||
        terminalFiles[path].type !==
          "folder"
      ) {
        return `tree: '${path}' not found`;
      }

      const lines = [
        terminalName(
          path
        ) ===
          "/"
          ? "."
          : terminalName(
              path
            )
      ];

      function walk(
        directory,
        prefix
      ) {
        const children =
          terminalChildren(
            directory
          );

        children.forEach(
          (
            child,
            index
          ) => {
            const last =
              index ===
              children.length -
                1;

            lines.push(
              `${prefix}${
                last
                  ? "└── "
                  : "├── "
              }${terminalName(
                child.path
              )}${
                child.type ===
                "folder"
                  ? "/"
                  : ""
              }`
            );

            if (
              child.type ===
              "folder"
            ) {
              walk(
                child.path,
                `${prefix}${
                  last
                    ? "    "
                    : "│   "
                }`
              );
            }
          }
        );
      }

      walk(
        path,
        ""
      );

      return lines.join(
        "\n"
      );
    }

    if (
      name ===
      "cat"
    ) {
      const path =
        terminalNormalizePath(
          argument
        );

      if (
        !terminalPathExists(
          path
        )
      ) {
        return `cat: ${path}: No such file`;
      }

      if (
        terminalFiles[path].type !==
        "file"
      ) {
        return `cat: ${path}: Is a directory`;
      }

      return String(
        terminalFiles[path]
          .content ||
          ""
      );
    }

    if (
      name ===
      "echo"
    ) {
      return argument;
    }

    if (
      name ===
      "mkdir"
    ) {
      const path =
        terminalNormalizePath(
          argument
        );

      return terminalAddFolder(
        path
      )
        ? `created directory ${path}`
        : `mkdir: cannot create directory '${path}'`;
    }

    if (
      name ===
      "touch"
    ) {
      const path =
        terminalNormalizePath(
          argument
        );

      return terminalAddFile(
        path
      )
        ? `created ${path}`
        : `touch: cannot create '${path}'`;
    }

    if (
      name ===
      "git" &&
      args[0] ===
        "status"
    ) {
      const files =
        Object.entries(
          terminalFiles
        )
          .filter(
            ([path]) =>
              path !== "/"
          )
          .map(
            ([path]) =>
              `  virtual ${path}`
          );

      return files.length
        ? [
            "On branch main",
            "",
            "Virtual workspace files:",
            ...files
          ].join(
            "\n"
          )
        : "On branch main\n\nnothing to show.";
    }

    if (
      name ===
        "git" &&
      args[0] ===
        "branch"
    ) {
      const project =
        activeProject();

      return project
        ? project.branches
            .map(
              branch =>
                `${
                  branch ===
                  projectState.branch
                    ? "*"
                    : " "
                } ${branch}`
            )
            .join("\n")
        : "* main";
    }

    if (
      name ===
        "git" &&
      args[0] ===
        "checkout"
    ) {
      const project =
        activeProject();

      const branch =
        args
          .slice(1)
          .join(" ")
          .trim();

      if (
        !project
      ) {
        return "fatal: no project is active";
      }

      if (
        !project.branches.includes(
          branch
        )
      ) {
        return `error: pathspec '${branch}' did not match any branch`;
      }

      projectState.branch =
        branch;

      ensureProjectChat(
        project,
        branch
      );

      saveProjects();

      return `Switched to branch '${branch}'`;
    }

    return `command not available in the safe Adnova terminal: ${name}`;
  }

  function createCodingTerminal() {
    const workspace =
      document.getElementById(
        "coding-workspace"
      );

    if (
      !workspace ||
      document.getElementById(
        "adnova-coding-terminal"
      )
    ) {
      return;
    }

    const terminal =
      document.createElement(
        "section"
      );

    terminal.id =
      "adnova-coding-terminal";

    terminal.className =
      "adnova-coding-terminal";

    terminal.innerHTML = `
      <div class="adnova-coding-terminal-header">

        <div>
          <strong>Terminal</strong>
          <span>Safe workspace shell</span>
        </div>

        <button
          type="button"
          id="adnova-coding-terminal-clear"
        >
          Clear
        </button>

      </div>

      <div
        id="adnova-coding-terminal-output"
        class="adnova-coding-terminal-output"
      >
        <div>
          Adnova safe terminal.
        </div>

        <div>
          Type <strong>help</strong> for available commands.
        </div>
      </div>

      <form
        id="adnova-coding-terminal-form"
        class="adnova-coding-terminal-form"
      >

        <span>›</span>

        <input
          id="adnova-coding-terminal-input"
          autocomplete="off"
          spellcheck="false"
          placeholder="Type a command..."
        >

      </form>
    `;

    workspace
      .querySelector(
        ".coding-main-panel"
      )
      ?.appendChild(
        terminal
      );

    const output =
      document.getElementById(
        "adnova-coding-terminal-output"
      );

    const inputEl =
      document.getElementById(
        "adnova-coding-terminal-input"
      );

    document
      .getElementById(
        "adnova-coding-terminal-clear"
      )
      ?.addEventListener(
        "click",
        () => {
          output.innerHTML =
            "";

          terminalHistory =
            [];
        }
      );

    document
      .getElementById(
        "adnova-coding-terminal-form"
      )
      ?.addEventListener(
        "submit",
        event => {
          event.preventDefault();

          const command =
            String(
              inputEl.value ||
                ""
            ).trim();

          if (
            !command
          ) {
            return;
          }

          terminalHistory.push(
            command
          );

          const result =
            runVirtualTerminalCommand(
              command
            );

          if (
            result ===
            "__CLEAR__"
          ) {
            output.innerHTML =
              "";
          } else {
            const commandRow =
              document.createElement(
                "div"
              );

            commandRow.className =
              "adnova-terminal-command";

            commandRow.textContent =
              `› ${command}`;

            output.appendChild(
              commandRow
            );

            if (
              result
            ) {
              const resultRow =
                document.createElement(
                  "pre"
                );

              resultRow.className =
                "adnova-terminal-result";

              resultRow.textContent =
                result;

              output.appendChild(
                resultRow
              );
            }
          }

          inputEl.value =
            "";

          output.scrollTop =
            output.scrollHeight;
        }
      );
  }

