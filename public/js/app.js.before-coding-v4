  return icons[mode] || icons.off;
}

function setCurrentMode(mode) {
  if (!AI_MODES[mode]) {
    mode = "off";
  }

  currentMode = mode;
  studyMode = mode === "study";

  updateModeButton();
  updateModeOptions();
  updateModeComposerState();

  if (typeof updateCodingWorkspaceState === "function") {
    updateCodingWorkspaceState();
  }

  updateActiveModeIndicator();
}

function updateModeButton() {
  const button =
    document.getElementById("mode-button");

  if (!button) {
    return;
