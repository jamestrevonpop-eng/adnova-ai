  refreshCacheWindow();

  /*
   * ---------------------------------------------------------
   * CACHE MEASUREMENT
   * ---------------------------------------------------------
   */

  async function measureAdnovaCacheBytes() {
    let total =
      0;

    if (
      typeof caches ===
        "undefined" ||
      typeof caches.keys !==
        "function"
    ) {
      return 0;
    }

    let cacheNames =
      [];

    try {
      cacheNames =
        await caches.keys();
    } catch {
      return 0;
    }

    cacheNames =
      cacheNames.filter(
        name =>
          name.startsWith(
            "adnova"
          )
      );

    for (
      const cacheName of
      cacheNames
    ) {
      let cache;

      try {
        cache =
          await caches.open(
            cacheName
          );
      } catch {
        continue;
      }

      let requests =
        [];

      try {
        requests =
          await cache.keys();
      } catch {
        continue;
      }

      for (
        const request of
        requests
      ) {
        try {
          const response =
            await cache.match(
              request
            );

          if (!response) {
            continue;
          }

          const contentLength =
            response.headers.get(
              "content-length"
            );

          if (
            contentLength &&
            Number.isFinite(
              Number(
                contentLength
              )
            )
          ) {
            total +=
              Number(
                contentLength
              );

            continue;
          }

          const clone =
            response.clone();

          const buffer =
            await clone.arrayBuffer();

          total +=
            buffer.byteLength;
        } catch {}
      }
    }

    return total;
  }

  async function getAdnovaLiveCacheStats() {
    refreshCacheWindow();

    const bytes =
      await measureAdnovaCacheBytes();

    const remainingResets =
      Math.max(
        CACHE_RESETS_PER_DAY -
          cacheMeta.resetsUsed,
        0
      );

    const nextResetAt =
      cacheMeta.windowStart +
      CACHE_WINDOW_MS;

    return {
      bytes,
      capacity:
        CACHE_CAPACITY,
      usedPercent:
        Math.min(
          (bytes /
            CACHE_CAPACITY) *
            100,
          100
        ),
      remainingResets,
      nextResetAt
    };
  }

  async function renderLiveCachePanel() {
    const used =
      document.getElementById(
