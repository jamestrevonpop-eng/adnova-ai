  function buildAdnovaPreviewDocument() {
    let html =
      getStudioFile(
        "/index.html"
      );

    const css =
      getStudioFile(
        "/style.css"
      );

    const js =
      getStudioFile(
        "/script.js"
      );

    if (
      !html
    ) {
      html =
`<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adnova Preview</title>
</head>
<body>
</body>
</html>`;
    }

    /*
     * Build a self-contained page.
     * This avoids relying on relative paths inside srcdoc.
     */

    const hasStyleTag =
      /<style[\s>]/i.test(
        html
      );

    const hasScriptTag =
      /<script[\s>]/i.test(
        html
      );

    if (
      css &&
      !hasStyleTag
    ) {
      if (
        /<\/head>/i.test(
          html
        )
      ) {
        html =
          html.replace(
            /<\/head>/i,
            `<style>${css}</style></head>`
          );
      } else {
        html =
          `<style>${css}</style>${html}`;
      }
    }

    if (
      js &&
      !hasScriptTag
    ) {
      if (
        /<\/body>/i.test(
          html
        )
      ) {
        html =
          html.replace(
            /<\/body>/i,
            `<script>${js}<\/script></body>`
          );
      } else {
        html +=
          `<script>${js}<\/script>`;
      }
    }

    return html;
  }

