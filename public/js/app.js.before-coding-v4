  /*
   * ---------------------------------------------------------
   * SAVE-SETTING CODE AGENT COMMAND SUPPORT
   * ---------------------------------------------------------
   */

  const oldSendMessage =
    window.__adnovaMemorySendMessageOriginal ||
    null;

  if (
    typeof sendMessage ===
      "function" &&
    !window.__adnovaMemorySendMessageWrapped
  ) {
    const original =
      sendMessage;

    window.__adnovaMemorySendMessageOriginal =
      original;

    window.__adnovaMemorySendMessageWrapped =
      true;

    sendMessage =
      async function () {
        const text =
          String(
            input?.value ||
              ""
          ).trim();

        if (
          text
        ) {
          const remembered =
            rememberUserPreference(
              text
            );

          if (
            remembered &&
            adnovaSettings.codeAgentAutoApply &&
            currentMode ===
              "coding" &&
            typeof setAdnovaSetting ===
              "function"
          ) {
            setAdnovaSetting(
              "codeAgentPreference",
              `${
                adnovaSettings.codeAgentPreference
                  ? `${adnovaSettings.codeAgentPreference}\n`
                  : ""
              }${remembered}`.slice(
                0,
                4000
              )
            );
          }
        }

        return original();
      };
  }

