  /*
   * ---------------------------------------------------------
   * PREVIEW
   * ---------------------------------------------------------
   */

  function buildPreviewDocument() {
    const html =
      studioState.files[
        "/index.html"
      ]?.content ||
      "";

    const css =
      studioState.files[
        "/style.css"
      ]?.content ||
      "";

    const js =
      studioState.files[
        "/script.js"
      ]?.content ||
      "";

    let documentText =
      html;

    if (
      !html
        .toLowerCase()
        .includes(
          "style.css"
        ) &&
      css
    ) {
      documentText =
        documentText.replace(
          "</head>",
          `<style>${css}</style></head>`
        );
    }

    if (
      !html
        .toLowerCase()
        .includes(
          "script.js"
        ) &&
      js
    ) {
      documentText =
        documentText.replace(
          "</body>",
          `<script>${js}<\/script></body>`
        );
    }

    return documentText;
  }

  function refreshPreview() {
    if (
      !previewFrame
    ) {
      return;
    }

    saveCurrentFileSilently();

    previewFrame.srcdoc =
      buildPreviewDocument();
  }

  function saveCurrentFileSilently() {
    const item =
      studioState.files[
        studioState.currentFile
      ];

    if (
      item &&
      item.type ===
        "file" &&
      editor
    ) {
      item.content =
        editor.value;

      saveStudioState();
    }
  }

  /*
   * ---------------------------------------------------------
   * SNAPSHOTS
   * ---------------------------------------------------------
   */

  function createSnapshot() {
    saveCurrentFileSilently();

    const project =
      {
        createdAt:
          Date.now(),

        files:
          JSON.parse(
            JSON.stringify(
              studioState.files
            )
          )
      };

    studioState.snapshots.unshift(
      project
    );

    studioState.snapshots =
      studioState.snapshots.slice(
        0,
        10
      );

    saveStudioState();

    showAdnovaNotification?.(
      "Coding workspace snapshot saved.",
      "success"
    );
  }

  /*
   * ---------------------------------------------------------
   * VIRTUAL WORKSPACE TERMINAL
   * ---------------------------------------------------------
   */

  function terminalWrite(
    value
  ) {
    const row =
      document.createElement(
        "div"
      );

    row.className =
      "adnova-studio-terminal-row";

    row.textContent =
      value;

    terminalOutput?.appendChild(
      row
    );

    if (
      terminalOutput
    ) {
      terminalOutput.scrollTop =
        terminalOutput.scrollHeight;
    }
  }

  function runStudioTerminal(
    command
  ) {
    terminalWrite(
      `› ${command}`
    );

    const tokens =
      command.match(
        /"[^"]*"|'[^']*'|\S+/g
      ) || [];

    const name =
      tokens[0] || "";

    const args =
      tokens
        .slice(1)
        .map(
          value =>
            value.replace(
              /^["']|["']$/g,
              ""
            )
        );

    if (
      name ===
      "help"
    ) {
      terminalWrite(
        [
          "help",
          "pwd",
          "ls [path]",
          "tree [path]",
          "cat <file>",
          "touch <file>",
          "mkdir <folder>",
          "rm <file-or-folder>",
          "write <file> <text>",
          "clear",
          "git status",
          "git branch",
          "git checkout <branch>"
        ].join(
          "  "
        )
      );

      return;
    }

    if (
      name ===
      "clear"
    ) {
      terminalOutput.innerHTML =
        "";

      return;
    }

    if (
      name ===
      "pwd"
    ) {
      terminalWrite(
        studioState.terminalPath
      );

      return;
    }

    if (
      name ===
      "ls"
    ) {
      const path =
        normalizePath(
          args[0] ||
            studioState.terminalPath
        );

      if (
        !exists(
          path
        )
      ) {
        terminalWrite(
          `ls: ${path}: not found`
        );

        return;
      }

      if (
        studioState.files[path]
          .type !==
        "folder"
      ) {
        terminalWrite(
          `${path} is not a directory`
        );

        return;
      }

      const children =
        childrenOf(
          path
        );

      terminalWrite(
        children.length
          ? children
              .map(
                item =>
                  `${fileName(
                    item.path
                  )}${
                    item.type ===
                    "folder"
                      ? "/"
                      : ""
                  }`
              )
              .join(
                "  "
              )
          : "(empty)"
      );

      return;
    }

    if (
      name ===
      "tree"
    ) {
      function tree(
        directory,
        prefix = ""
      ) {
        const result =
          [];

        childrenOf(
          directory
        ).forEach(
          item => {
            result.push(
              `${prefix}${fileName(
                item.path
              )}${
                item.type ===
                "folder"
                  ? "/"
                  : ""
              }`
            );

            if (
              item.type ===
              "folder"
            ) {
              result.push(
                ...tree(
                  item.path,
                  `${prefix}  `
                )
              );
            }
          }
        );

        return result;
      }

      terminalWrite(
        tree(
          normalizePath(
            args[0] ||
              "/"
          )
        ).join(
          "\n"
        ) ||
          "."
      );

      return;
    }

    if (
      name ===
      "cat"
    ) {
      const path =
        normalizePath(
          args[0]
        );

      const item =
        studioState.files[
          path
        ];

      if (
        !item
      ) {
        terminalWrite(
          `cat: ${path}: not found`
        );

        return;
      }

      if (
        item.type !==
        "file"
      ) {
        terminalWrite(
          `cat: ${path}: is a directory`
        );

        return;
      }

      terminalWrite(
        item.content ||
          ""
      );

      return;
    }

    if (
      name ===
      "touch"
    ) {
      const path =
        normalizePath(
          args[0]
        );

      if (
        addFile(
          path
        )
      ) {
        renderFileTree();

        terminalWrite(
          `created ${path}`
        );
      } else {
        terminalWrite(
          `touch: could not create ${path}`
        );
      }

      return;
    }

    if (
      name ===
      "mkdir"
    ) {
      const path =
        normalizePath(
          args[0]
        );

      if (
        addFolder(
          path
        )
      ) {
        renderFileTree();

        terminalWrite(
          `created ${path}/`
        );
      } else {
        terminalWrite(
          `mkdir: could not create ${path}`
        );
      }

      return;
    }

    if (
      name ===
      "rm"
    ) {
      const path =
        normalizePath(
          args[0]
        );

      if (
        removePath(
          path
        )
      ) {
        renderFileTree();

        openStudioFile(
          studioState.currentFile
        );

        terminalWrite(
          `removed ${path}`
        );
      } else {
        terminalWrite(
          `rm: could not remove ${path}`
        );
      }

      return;
    }

    if (
      name ===
      "write"
    ) {
      const path =
        normalizePath(
          args.shift()
        );

      const text =
        args.join(
          " "
        );

      const item =
        studioState.files[
          path
        ];

      if (
        !item ||
        item.type !==
          "file"
      ) {
        terminalWrite(
          `write: ${path}: not found`
        );

        return;
      }

      item.content =
        text;

      saveStudioState();
      renderFileTree();

      if (
        path ===
        studioState.currentFile
      ) {
        openStudioFile(
          path
        );
      }

      terminalWrite(
        `updated ${path}`
      );

      return;
    }

    if (
      name ===
      "git" &&
      args[0] ===
        "status"
    ) {
      terminalWrite(
        "On branch main\n\nVirtual Adnova workspace ready."
      );

      return;
    }

    if (
      name ===
      "git" &&
      args[0] ===
        "branch"
    ) {
      const branches =
        activeProject?.()
          ?.branches || [
            "main"
          ];

      terminalWrite(
        branches
          .map(
            branch =>
              `${
                branch ===
                projectState?.branch
                  ? "*"
                  : " "
              } ${branch}`
          )
          .join(
            "\n"
          )
      );

      return;
    }

    if (
      name ===
        "git" &&
      args[0] ===
        "checkout"
    ) {
      terminalWrite(
        `Branch commands are connected to Projects.`
      );

      return;
    }

    terminalWrite(
      `command not available in the Adnova workspace: ${name}`
    );
  }

  /*
   * ---------------------------------------------------------
   * DOWNLOAD PROJECT AS ZIP
   * ---------------------------------------------------------
   */

  function crc32(
    bytes
  ) {
    let crc =
      0xffffffff;

    for (
      const byte of
      bytes
    ) {
      crc ^=
        byte;

      for (
        let bit = 0;
        bit < 8;
        bit++
      ) {
        crc =
          (
            crc >>> 1
          ) ^
          (
            (crc & 1)
              ? 0xedb88320
              : 0
          );
      }
    }

    return (
      crc ^
      0xffffffff
    ) >>> 0;
  }

  function u16(
    value
  ) {
    return new Uint8Array([
      value & 255,
      (value >>> 8) & 255
    ]);
  }

  function u32(
    value
  ) {
    return new Uint8Array([
      value & 255,
      (value >>> 8) & 255,
      (value >>> 16) & 255,
      (value >>> 24) & 255
    ]);
  }

  function concatBytes(
    arrays
  ) {
    const total =
      arrays.reduce(
        (
          size,
          array
        ) =>
          size +
          array.length,
        0
      );

    const output =
      new Uint8Array(
        total
      );

    let offset =
      0;

    arrays.forEach(
      array => {
        output.set(
          array,
          offset
        );

        offset +=
          array.length;
      }
    );

    return output;
  }

  async function makeZip(
    files
  ) {
    const encoder =
      new TextEncoder();

    const locals =
      [];

    const central =
      [];

    let offset =
      0;

    for (
      const [path, item]
      of Object.entries(
        files
      )
    ) {
      if (
        path === "/" ||
        item.type !==
          "file"
      ) {
        continue;
      }

      const name =
        path
          .replace(
            /^\//,
            ""
          );

      const nameBytes =
        encoder.encode(
          name
        );

      const data =
        encoder.encode(
          String(
            item.content ||
              ""
          )
        );

      const checksum =
        crc32(
          data
        );

      const localHeader =
        concatBytes([
          new Uint8Array([
            0x50,
            0x4b,
            0x03,
            0x04
          ]),

          u16(20),
          u16(0x800),
          u16(0),
          u16(0),
          u16(0),

          u32(checksum),
          u32(data.length),
          u32(data.length),

          u16(nameBytes.length),
          u16(0)
        ]);

      const localRecord =
        concatBytes([
          localHeader,
          nameBytes,
          data
        ]);

      locals.push(
        localRecord
      );

      const centralHeader =
        concatBytes([
          new Uint8Array([
            0x50,
            0x4b,
            0x01,
            0x02
          ]),

          u16(20),
          u16(20),
          u16(0x800),
          u16(0),
          u16(0),
          u16(0),

          u32(checksum),
          u32(data.length),
          u32(data.length),

          u16(nameBytes.length),
          u16(0),
          u16(0),
          u16(0),
          u16(0),

          u32(0),
          u32(offset)
        ]);

      central.push(
        concatBytes([
          centralHeader,
          nameBytes
        ])
      );

      offset +=
        localRecord.length;
    }

    const centralSize =
      central.reduce(
        (
          size,
          part
        ) =>
          size +
          part.length,
        0
      );

    const centralOffset =
      offset;

    const end =
      concatBytes([
        new Uint8Array([
          0x50,
          0x4b,
          0x05,
          0x06
        ]),

        u16(0),
        u16(0),

        u16(
          central.length
        ),
        u16(
          central.length
        ),

        u32(
          centralSize
        ),
        u32(
          centralOffset
        ),

        u16(0)
      ]);

    return concatBytes([
      ...locals,
      ...central,
      end
    ]);
  }

  async function downloadProject() {
    saveCurrentFileSilently();

    const projectFiles =
      Object.fromEntries(
        Object.entries(
          studioState.files
        ).filter(
          ([path, item]) =>
            path !== "/" &&
            item.type ===
              "file"
        )
      );

    const zip =
      await makeZip(
        projectFiles
      );

    const blob =
      new Blob(
        [
          zip
        ],
        {
          type:
            "application/zip"
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const link =
      document.createElement(
        "a"
      );

    link.href =
      url;

    link.download =
      "adnova-project.zip";

    document.body.appendChild(
      link
    );

    link.click();

    link.remove();

    URL.revokeObjectURL(
      url
    );

    showAdnovaNotification?.(
      "Project downloaded as a ZIP.",
      "success"
    );
  }

  /*
   * ---------------------------------------------------------
   * WAIT FOR CODING WORKSPACE
   * ---------------------------------------------------------
   */

  let lastWorkspace =
    null;

  const studioObserver =
    new MutationObserver(
      () => {
        const workspace =
          document.getElementById(
            "coding-workspace"
          );

        if (
          workspace &&
          workspace !==
            lastWorkspace
        ) {
          lastWorkspace =
            workspace;

          setTimeout(
            createStudio,
            0
          );
        }

        if (
          studioRoot &&
          !document.body.contains(
            studioRoot
          )
        ) {
          studioRoot =
            null;
        }
      }
    );

  studioObserver.observe(
    document.body,
    {
      childList: true,
      subtree: true
    }
  );

  const existingWorkspace =
    document.getElementById(
      "coding-workspace"
    );

  if (
    existingWorkspace
  ) {
    lastWorkspace =
      existingWorkspace;

    createStudio();
  }

  /*
   * Rebuild when Coding becomes active.
   */

  setInterval(
    () => {
      const workspace =
        document.getElementById(
          "coding-workspace"
        );

      if (
        workspace &&
        !document.getElementById(
          "adnova-coding-studio"
        )
      ) {
        createStudio();
      }
    },
    500
  );
})();

