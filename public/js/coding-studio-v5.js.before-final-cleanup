  function saveProject() {
    const projects =
      loadProjects();

    if (
      !studio.project.id
    ) {
      const name =
        window.prompt(
          "Project name",
          studio.project.name ===
            "Untitled"
            ? ""
            : studio.project.name
        );

      if (!name) {
        return;
      }

      studio.project.name =
        name.trim().slice(
          0,
          80
        );

      studio.project.id =
        `${Date.now()}-${Math.random()
          .toString(36)
          .slice(2,8)}`;
    }

    const current =
      cleanProject(
        studio.project
      );

    const index =
      projects.findIndex(
        project =>
          project.id ===
          current.id
      );

    if (
      index >= 0
    ) {
      projects[index] =
        current;
    } else {
      if (
        projects.length >=
        MAX_PROJECTS
      ) {
        toast(
          "You already have 5 saved projects.",
          "error"
        );

        return;
      }

      projects.unshift(
        current
      );
    }

    saveProjects(
      projects
    );

    saveDraft();

    document.querySelector(
      "#adnova-v5-project-name"
    ).textContent =
      current.name;

    toast(
      `Project saved: ${current.name}`
    );
  }

