    const open =
      typeof force ===
      "boolean"
        ? force
        : !panel.classList.contains(
            "open"
          );

    panel.classList.toggle(
      "open",
      open
    );

    if (open) {
      document.querySelector(
        "#adnova-v5-ai-input"
      )?.focus();
    }
  }

