    overlay.innerHTML = `
      <div class="adnova-v5-run-card">

        <h3>
          Project started
        </h3>

        <p>
          Your project is running in the Adnova preview environment.
          Open it in a new browser tab?
        </p>

        <div class="adnova-v5-run-actions">

          <button
            class="adnova-v5-btn"
            data-close
          >
            Not now
          </button>

          <button
            class="adnova-v5-btn primary"
            data-open
          >
            Open in New Tab
          </button>

        </div>

      </div>
    `;

    document.body.appendChild(
      overlay
    );

    overlay
      .querySelector(
        "[data-open]"
      )
      .addEventListener(
        "click",
        () => {
          overlay.remove();

          switchPane(
            "preview"
          );

          openNewTab();
        }
      );

    overlay
      .querySelector(
        "[data-close]"
      )
      .addEventListener(
        "click",
        () =>
          overlay.remove()
      );

    setTimeout(
      () => {
        if (
          overlay.isConnected
        ) {
          overlay.remove();
        }
      },
      10000
    );
  }

  function backupProject() {
    studio.project.backups =
      [
        {
          createdAt:
            Date.now(),

          files:
            clone(
              studio.project.files
            ),

          folders:
            clone(
              studio.project.folders
            )
        },
        ...(studio.project.backups || [])
      ].slice(
        0,
        MAX_BACKUPS
      );

    saveDraft();

    terminalPrint(
      "[backup] local backup created\n"
    );

    toast(
      "Backup created."
    );
  }

  function restoreBackup(index) {
    const backup =
      studio.project.backups?.[
        Number(index) || 0
      ];

    if (!backup) {
      terminalPrint(
        "restore: backup not found\n"
      );

      return;
    }

    studio.project.files =
      clone(
        backup.files
      );

    studio.project.folders =
      clone(
        backup.folders
      );

    saveDraft();

    renderTree();

    openFile(
      studio.project.currentFile ||
      "/index.html"
    );

    refreshPreview();

    terminalPrint(
      "[restore] backup restored\n"
    );
  }

  function searchFiles(query) {
    if (!query) {
      terminalPrint(
        "search: missing text\n"
      );

      return;
    }

    let found = false;

    getFiles().forEach(
      file => {
        const content =
          String(
            studio.project.files[
              file
            ] || ""
          );

        if (
          content
            .toLowerCase()
            .includes(
              query.toLowerCase()
            )
        ) {
          terminalPrint(
            `${file}\n`
          );

          found = true;
        }
      }
    );

    if (!found) {
      terminalPrint(
        "No matches.\n"
      );
    }
  }

  function showProjects() {
    const projects =
      loadProjects();

    terminalPrint(
      "\nPROJECTS\n"
    );

    if (!projects.length) {
      terminalPrint(
        "No saved projects.\n"
      );

      return;
    }

    projects.forEach(
      (project, index) => {
        terminalPrint(
          `${index + 1}. ${project.name}\n`
        );
      }
    );

    terminalPrint(
      "Use 'open-project <number>' after saving a project.\n"
    );
  }

  function downloadProject() {
    const blob =
      new Blob(
        [
          JSON.stringify(
            cleanProject(
              studio.project
            ),
            null,
            2
          )
        ],
        {
          type:
            "application/json"
        }
      );

    const url =
      URL.createObjectURL(
        blob
      );

    const link =
      document.createElement(
        "a"
      );

    link.href =
      url;

    link.download =
      `${studio.project.name
        .replace(
          /[^a-z0-9-_]+/gi,
          "-"
        ) || "adnova-project"}.adnova.json`;

    link.click();

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      5000
    );
  }

  function updateStorage() {
    const node =
      document.querySelector(
        "#adnova-v5-storage"
      );

    if (!node) {
      return;
    }

    let bytes = 0;

    Object.entries(
      studio.project.files
    ).forEach(
      ([path, content]) => {
        bytes +=
          (
            path.length +
            String(
              content || ""
            ).length
          ) * 2;
      }
    );

    node.innerHTML =
      `<strong>Project storage</strong><br>${(
        bytes / 1024
      ).toFixed(1)} KB<br><span style="color:#838995;">Live local project usage</span>`;
  }

  window.adnovaCodingStudioV5 =
    {
      sync,
      mount,
      unmount
    };

  window.updateCodingWorkspaceState =
    function () {
      sync();
    };

  installStyles();

  setInterval(
    () => {
      if (
        document.body.classList.contains(
          "adnova-v5-coding"
        )
      ) {
        updateStorage();
        updateTerminalPrompt();
      }
    },
    1000
  );

  setTimeout(
    sync,
    0
  );

})();
