  function buildPreviewHtml() {
    let html =
      studio.project.files[
        "/index.html"
      ] ||
      "<!doctype html><html><body><h1>No index.html</h1></body></html>";

    const css =
      studio.project.files[
        "/style.css"
      ] || "";

    const js =
      studio.project.files[
        "/script.js"
      ] || "";

    html =
      html.replace(
        /<link[^>]+href=["'](?:\.\/|\/)?style\.css["'][^>]*>\s*/gi,
        ""
      );

    html =
      html.replace(
        /<script[^>]+src=["'](?:\.\/|\/)?script\.js["'][^>]*>\s*<\/script>\s*/gi,
        ""
      );

    const styleTag =
      `<style>${css}</style>`;

    const safeJs =
      js.replace(
        /<\/script/gi,
        "<\\/script"
      );

    const scriptTag =
      `<script>${safeJs}<\/script>`;

    if (
      /<\/head>/i.test(
        html
      )
    ) {
      html =
        html.replace(
          /<\/head>/i,
          `${styleTag}</head>`
        );
    } else {
      html =
        `${styleTag}${html}`;
    }

    if (
      /<\/body>/i.test(
        html
      )
    ) {
      html =
        html.replace(
          /<\/body>/i,
          `${scriptTag}</body>`
        );
    } else {
      html += scriptTag;
    }

    return html;
  }

  function refreshPreview() {
    const frame =
      document.querySelector(
        "#adnova-v5-preview-frame"
      );

    if (!frame) {
      return;
    }

    if (
      previewUrl
    ) {
      URL.revokeObjectURL(
        previewUrl
      );
    }

    previewUrl =
      URL.createObjectURL(
        new Blob(
          [
            buildPreviewHtml()
          ],
          {
            type:
              "text/html"
          }
        )
      );

    frame.src =
      previewUrl;

    const status =
      document.querySelector(
        "#adnova-v5-preview-status"
      );

    if (status) {
      status.textContent =
        `Updated ${new Date()
          .toLocaleTimeString()}`;
    }
  }

  function openNewTab() {
    const url =
      URL.createObjectURL(
        new Blob(
          [
            buildPreviewHtml()
          ],
          {
            type:
              "text/html"
          }
        )
      );

    const tab =
      window.open(
        url,
        "_blank"
      );

    if (!tab) {
      toast(
        "The browser blocked the new tab.",
        "error"
      );
    }

    setTimeout(
      () =>
        URL.revokeObjectURL(
          url
        ),
      10 * 60 * 1000
    );
  }

