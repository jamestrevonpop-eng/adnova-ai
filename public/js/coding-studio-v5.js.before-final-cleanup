            "FILE: /path/file.ext\n" +
            "```language\n" +
            "file contents\n" +
            "```\n" +
            "Create folders by returning files inside them.\n" +
            "Do not claim commands actually executed.\n" +
            "npm, node, Socket.IO and server execution are virtual until a real Coding API is connected.\n" +
            `CURRENT PROJECT:\n${files}`
        },

        ...(studio.project.ai || [])
          .slice(-12)
          .map(
            message => ({
              role:
                message.role,
              content:
                message.content
            })
          )
      ];

      const response =
        await fetch(
          "/api/chat",
          {
            method:"POST",
            headers:{
              "Content-Type":
                "application/json"
            },
            body:
              JSON.stringify({
                messages,
                aiPreference:
                  settings?.codeAgentPreference ||
                  ""
              })
          }
        );

      const data =
        await response
          .json()
          .catch(
            () => ({})
          );

      if (!response.ok) {
        throw new Error(
          data?.error ||
          `Request failed (${response.status})`
        );
      }

      const reply =
        String(
          data?.reply ||
          ""
        ).trim();

      if (!reply) {
        throw new Error(
          "Coding AI returned nothing."
        );
      }

      studio.project.ai =
        [
          ...(studio.project.ai || []),
          {
            role:"assistant",
            content:reply
          }
        ].slice(-30);

      const changed =
        applyAiFiles(
          reply
        );

      saveDraft();

      renderAi();
      renderTree();

      openFile(
        studio.project.currentFile ||
        "/index.html"
      );

      refreshPreview();
      validateCurrentFile();

      toast(
        changed
          ? `Coding AI updated ${changed} file(s).`
          : "Coding AI replied without file blocks."
      );

    } catch (error) {
      console.error(
        "Coding AI:",
        error
      );

      studio.project.ai =
        [
          ...(studio.project.ai || []),
          {
            role:"assistant",
            content:
              `Error: ${error.message}`
          }
        ].slice(-30);

      renderAi();

      toast(
        error.message ||
        "Coding AI failed.",
        "error"
      );

    } finally {
      button.disabled = false;
    }
  }

  function applyAiFiles(reply) {
    const changed =
      [];

    const pattern =
      /FILE\s*:\s*([^\n`]+)\s*\n\s*```[^\n]*\n([\s\S]*?)```/gi;

    let match;

    while (
      (match =
        pattern.exec(reply))
    ) {
      const path =
        normalizePath(
          match[1].trim()
        );

      if (
        path === "/" ||
        path.includes("..")
      ) {
        continue;
      }

      studio.project.files[path] =
        String(
          match[2] ||
          ""
        ).trim();

      const folder =
        parentPath(path);

      if (
        folder !== "/"
      ) {
        studio.project.folders.push(
          folder
        );
      }

      changed.push(
        path
      );
    }

    if (
      changed.length
    ) {
      studio.project.folders =
        [
          ...new Set(
            studio.project.folders.map(
              normalizePath
            )
          )
        ];

      studio.project.currentFile =
        changed[0];
    }

    return changed.length;
  }

  function validateCurrentFile() {
    const path =
      studio?.project?.currentFile;

    if (!path) {
      return;
    }

    const code =
      String(
        studio.project.files[path] ||
        ""
      );

    const extension =
      baseName(path)
        .split(".")
        .pop()
        .toLowerCase();

    const issues =
      [];

    if (
      [
        "js",
        "ts"
      ].includes(extension)
    ) {
      let balance =
        0;

      for (
        const character of code
      ) {
        if (
          character === "{"
        ) balance++;

        if (
          character === "}"
        ) balance--;

        if (
          balance < 0
        ) {
          break;
        }
      }

      if (
        balance !== 0
      ) {
        issues.push(
          "Braces are not balanced in this file."
        );
      }

      if (
        /(^|[^=!])===\s*;/.test(
          code
        )
      ) {
        issues.push(
          "There appears to be an invalid comparison expression."
        );
      }
    }

    if (
      extension ===
      "html"
    ) {
      if (
        !/<!doctype\s+html/i.test(
          code
        )
      ) {
        issues.push(
          "This HTML file has no DOCTYPE declaration."
        );
      }

      const openTags =
        (
          code.match(
            /<([a-z][a-z0-9-]*)\b/gi
          ) || []
        ).length;

      const closeTags =
        (
          code.match(
            /<\/([a-z][a-z0-9-]*)>/gi
          ) || []
        ).length;

      if (
        Math.abs(
          openTags -
          closeTags
        ) > 2
      ) {
        issues.push(
          "Some HTML tags may be unclosed."
        );
      }
    }

    if (
      extension ===
      "css"
    ) {
      const opens =
        (
          code.match(
            /{/g
          ) || []
        ).length;

      const closes =
        (
          code.match(
            /}/g
          ) || []
        ).length;

      if (
        opens !==
        closes
      ) {
        issues.push(
          "CSS braces are not balanced."
        );
      }
    }

    const issue =
      document.querySelector(
        "#adnova-v5-issue"
      );

    const issueText =
      document.querySelector(
        "#adnova-v5-issue-text"
      );

    const editor =
      document.querySelector(
        "#adnova-v5-code"
      );

    const hasIssue =
      issues.length > 0;

    issue?.classList.toggle(
      "show",
      hasIssue
    );

    editor?.classList.toggle(
      "invalid",
      hasIssue
    );

    if (issueText) {
      issueText.textContent =
        issues[0] ||
        "";
    }
  }

  async function debugCurrentFile() {
    const issue =
      document.querySelector(
        "#adnova-v5-issue-text"
      )?.textContent ||
      "The current file may contain a problem.";

    const confirmed =
      window.confirm(
        "This file appears to have an issue. Ask Coding AI to debug it?"
      );

    if (!confirmed) {
      return;
    }

    toggleAi(true);

    const input =
      document.querySelector(
        "#adnova-v5-ai-input"
      );

