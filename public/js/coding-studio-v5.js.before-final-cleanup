  function toggleTerminal(force) {
    const drawer =
      document.querySelector(
        "#adnova-v5-terminal"
      );

    if (!drawer) {
      return;
    }

    terminalOpen =
      typeof force ===
      "boolean"
        ? force
        : !terminalOpen;

    drawer.classList.toggle(
      "open",
      terminalOpen
    );

    if (
      terminalOpen
    ) {
      document.querySelector(
        "#adnova-v5-terminal-input"
      )?.focus();
    }
  }

  function terminalPrint(text) {
    const log =
      document.querySelector(
        "#adnova-v5-terminal-log"
      );

    if (!log) {
      return;
    }

    log.textContent +=
      text;

    log.scrollTop =
      log.scrollHeight;
  }

  function updateTerminalPrompt() {
    const cwd =
      studio?.project?.cwd ||
      "/";

    const prompt =
      document.querySelector(
        "#adnova-v5-terminal-prompt"
      );

    const status =
      document.querySelector(
        "#adnova-v5-terminal-status"
      );

    if (prompt) {
      prompt.textContent =
        `${cwd} $`;
    }

    if (status) {
      status.textContent =
        cwd;
    }
  }

  function terminalKeydown(event) {
    if (
      event.key !==
      "Enter"
    ) {
      return;
    }

    event.preventDefault();

    const input =
      event.currentTarget;

    const command =
      input.value.trim();

    input.value = "";

    if (
      command
    ) {
      runCommand(
        command
      );
    }
  }

  function resolvePath(target) {
    const raw =
      String(
        target ||
        studio.project.cwd
      );

    if (
      raw.startsWith("/")
    ) {
      return normalizePath(
        raw
      );
    }

    return normalizePath(
      `${studio.project.cwd === "/" ? "" : studio.project.cwd}/${raw}`
    );
  }

  function runCommand(raw) {
    terminalPrint(
      `${studio.project.cwd} $ ${raw}\n`
    );

    const parts =
      raw.match(
        /"[^"]*"|'[^']*'|[^\s]+/g
      ) || [];

    const command =
      String(
        parts.shift() ||
        ""
      )
        .toLowerCase();

    const args =
      parts.map(
        value =>
          value.replace(
            /^["']|["']$/g,
            ""
          )
      );

    switch (command) {

      case "help":
        terminalPrint(
          "help\n" +
          "pwd\n" +
          "ls\n" +
          "tree\n" +
          "cd <folder>\n" +
          "cat <file>\n" +
          "touch <file>\n" +
          "mkdir <folder>\n" +
          "rm <file/folder>\n" +
          "mv <from> <to>\n" +
          "cp <from> <to>\n" +
          "open <file>\n" +
          "write <file> <text>\n" +
          "save\n" +
          "backup\n" +
          "restore [number]\n" +
          "snapshot\n" +
          "preview\n" +
          "projects\n" +
          "new\n" +
          "status\n" +
          "history\n" +
          "echo <text>\n" +
          "find <text>\n" +
          "grep <text>\n" +
          "npm install\n" +
          "npm start\n" +
          "npm run <script>\n" +
          "npm init\n" +
          "npm --version\n" +
          "node --version\n" +
          "socket\n" +
          "download\n" +
          "clear\n"
        );
        break;

      case "pwd":
        terminalPrint(
          `${studio.project.cwd}\n`
        );
        break;

      case "ls":
        terminalList(
          args[0]
        );
        break;

      case "tree":
        terminalTree();
        break;

      case "cd":
        terminalCd(
          args[0] ||
          "/"
        );
        break;

      case "cat":
        terminalCat(
          args[0]
        );
        break;

      case "touch":
        terminalTouch(
          args[0]
        );
        break;

      case "mkdir":
        terminalMkdir(
          args
        );
        break;

      case "rm":
        terminalRm(
          args[0]
        );
        break;

      case "mv":
        terminalMove(
          args[0],
          args[1]
        );
        break;

      case "cp":
        terminalCopy(
          args[0],
          args[1]
        );
        break;

      case "open":
        if (
          args[0]
        ) {
          openFile(
            resolvePath(
              args[0]
            )
          );
          switchPane(
            "build"
          );
        }
        break;

      case "write":
        terminalWrite(
          args
        );
        break;

      case "save":
        saveEditor();
        break;

      case "backup":
        backupProject();
        break;

      case "restore":
        restoreBackup(
          Number(
            args[0] || 0
          )
        );
        break;

      case "snapshot":
        createSnapshot();
        break;

      case "preview":
        switchPane(
          "preview"
        );
        break;

      case "projects":
        showProjects();
        break;

      case "new":
        newCodingChat();
        break;

      case "status":
        terminalStatus();
        break;

      case "history":
        terminalPrint(
          "Terminal history is active for this session.\n"
        );
        break;

      case "echo":
        terminalPrint(
          `${args.join(" ")}\n`
        );
        break;

      case "find":
      case "grep":
        searchFiles(
          args.join(" ")
        );
        break;

      case "npm":
        terminalNpm(
          args
        );
        break;

      case "node":
        if (
          args[0] ===
          "--version"
        ) {
          terminalPrint(
            "v22.x (virtual runtime placeholder)\n"
          );
        } else {
          terminalPrint(
            "node execution is not connected yet. A future Coding API will provide the real runtime.\n"
          );
        }
        break;

      case "socket":
        terminalPrint(
          "Socket support is reserved for the future real Coding API.\n"
        );
        break;

      case "download":
        downloadProject();
        break;

      case "clear": {
        const log =
          document.querySelector(
            "#adnova-v5-terminal-log"
          );

        if (log) {
          log.textContent =
            "";
        }

        break;
      }

      default:
        terminalPrint(
          `command not found: ${command}\n`
        );
    }

    updateTerminalPrompt();
  }

  function terminalList(target) {
    const base =
      resolvePath(
        target ||
        studio.project.cwd
      );

    const rows = [];

    (
      studio.project.folders ||
      []
    ).forEach(
      folder => {
        if (
          parentPath(folder) ===
          base
        ) {
          rows.push(
            `[DIR]  ${baseName(folder)}`
          );
        }
      }
    );

    getFiles().forEach(
      file => {
        if (
          parentPath(file) ===
          base
        ) {
          rows.push(
            `       ${baseName(file)}`
          );
        }
      }
    );

    terminalPrint(
      `${rows.join("\n") || "(empty)"}\n`
    );
  }

  function terminalTree() {
    terminalPrint(
      "/\n" +
      getFiles()
        .map(
          file =>
            `  ${file}`
        )
        .join("\n") +
      "\n"
    );
  }

  function terminalCd(target) {
    const next =
      resolvePath(
        target
      );

    if (
      next !== "/" &&
      !studio.project.folders.includes(
        next
      ) &&
      !getFiles().some(
        file =>
          parentPath(file) ===
          next
      )
    ) {
      terminalPrint(
        `cd: no such directory: ${next}\n`
      );

      return;
    }

    studio.project.cwd =
      next;

    saveDraft();
  }

  function terminalCat(target) {
    if (!target) {
      terminalPrint(
        "cat: missing file\n"
      );

      return;
    }

    const path =
      resolvePath(
        target
      );

    if (
      !Object.prototype.hasOwnProperty.call(
        studio.project.files,
        path
      )
    ) {
      terminalPrint(
        `cat: ${path}: no such file\n`
      );

      return;
    }

    terminalPrint(
      `${studio.project.files[path]}\n`
    );
  }

  function terminalTouch(target) {
    if (!target) {
      terminalPrint(
        "touch: missing file name\n"
      );

      return;
    }

    const path =
      resolvePath(
        target
      );

    if (
      !Object.prototype.hasOwnProperty.call(
        studio.project.files,
        path
      )
    ) {
      studio.project.files[path] =
        "";

      studio.project.folders.push(
        parentPath(path)
      );

      studio.project.folders =
        [
          ...new Set(
            studio.project.folders
              .map(
                normalizePath
              )
          )
        ];

      saveDraft();
      renderTree();
    }

    openFile(
      path
    );

    terminalPrint(
      `created ${path}\n`
    );
  }

  function terminalMkdir(args) {
    if (!args.length) {
      terminalPrint(
        "mkdir: missing folder name\n"
      );

      return;
    }

    const recursive =
      args.includes("-p");

    const target =
      args.find(
        value =>
          value !== "-p"
      );

    const path =
      resolvePath(
        target
      );

    if (
      recursive
    ) {
      let current = "/";

      path
        .split("/")
        .filter(Boolean)
        .forEach(
          part => {
            current =
              normalizePath(
                `${current}/${part}`
              );

            studio.project.folders.push(
              current
            );
          }
        );
    } else {
      studio.project.folders.push(
        path
      );
    }

    studio.project.folders =
      [
        ...new Set(
          studio.project.folders.map(
            normalizePath
          )
        )
      ];

    saveDraft();
    renderTree();

    terminalPrint(
      `created ${path}\n`
    );
  }

  function terminalRm(target) {
    if (!target) {
      terminalPrint(
        "rm: missing path\n"
      );

      return;
    }

    const path =
      resolvePath(
        target
      );

    if (
      Object.prototype.hasOwnProperty.call(
        studio.project.files,
        path
      )
    ) {
      delete studio.project.files[
        path
      ];

      saveDraft();

      renderTree();

      openFile(
        getFiles()[0] ||
        "/index.html"
      );

      terminalPrint(
        `removed ${path}\n`
      );

      return;
    }

    studio.project.folders =
      studio.project.folders.filter(
        folder =>
          folder !== path &&
          !folder.startsWith(
            `${path}/`
          )
      );

    getFiles().forEach(
      file => {
        if (
          file.startsWith(
            `${path}/`
          )
        ) {
          delete studio.project.files[
            file
          ];
        }
      }
    );

    saveDraft();
    renderTree();

    openFile(
      getFiles()[0] ||
      "/index.html"
    );

    terminalPrint(
      `removed ${path}\n`
    );
  }

  function terminalMove(
    from,
    to
  ) {
    if (
      !from ||
      !to
    ) {
      terminalPrint(
        "mv: usage mv FROM TO\n"
      );

      return;
    }

    const source =
      resolvePath(from);

    const destination =
      resolvePath(to);

    if (
      !Object.prototype.hasOwnProperty.call(
        studio.project.files,
        source
      )
    ) {
      terminalPrint(
        `mv: no such file: ${source}\n`
      );

      return;
    }

    studio.project.files[
      destination
    ] =
      studio.project.files[
        source
      ];

    delete studio.project.files[
      source
    ];

    if (
      studio.project.currentFile ===
      source
    ) {
      studio.project.currentFile =
        destination;
    }

    saveDraft();
    renderTree();

    openFile(
      destination
    );
  }

  function terminalCopy(
    from,
    to
  ) {
    if (
      !from ||
      !to
    ) {
      terminalPrint(
        "cp: usage cp FROM TO\n"
      );

      return;
    }

    const source =
      resolvePath(from);

    const destination =
      resolvePath(to);

    if (
      !Object.prototype.hasOwnProperty.call(
        studio.project.files,
        source
      )
    ) {
      terminalPrint(
        `cp: no such file: ${source}\n`
      );

      return;
    }

    studio.project.files[
      destination
    ] =
      studio.project.files[
        source
      ];

    saveDraft();
    renderTree();

    terminalPrint(
      `copied ${source} -> ${destination}\n`
    );
  }

  function terminalWrite(args) {
    if (
      args.length <
      2
    ) {
      terminalPrint(
        'write: usage write /file.txt "content"\n'
      );

      return;
    }

    const path =
      resolvePath(
        args.shift()
      );

    studio.project.files[path] =
      args.join(" ");

    studio.project.folders.push(
      parentPath(path)
    );

    studio.project.folders =
      [
        ...new Set(
          studio.project.folders.map(
            normalizePath
          )
        )
      ];

    studio.project.currentFile =
      path;

    saveDraft();

    renderTree();

    openFile(
      path
    );

    terminalPrint(
      `wrote ${path}\n`
    );
  }

  function terminalStatus() {
    terminalPrint(
      `project: ${studio.project.name}\n` +
      `files: ${getFiles().length}\n` +
      `folders: ${studio.project.folders.length}\n` +
      `backups: ${(studio.project.backups || []).length}\n` +
      `snapshots: ${(studio.project.snapshots || []).length}\n`
    );
  }

  function terminalNpm(args) {
    const sub =
      String(
        args[0] ||
        ""
      ).toLowerCase();

    if (
      sub ===
      "install"
    ) {
      const npm =
        json(
          NPM_KEY,
          {}
        );

      npm.installed =
        true;

      npm.installedAt =
        Date.now();

      localStorage.setItem(
        NPM_KEY,
        JSON.stringify(npm)
      );

      terminalPrint(
        "npm install complete.\n" +
        "Virtual dependency environment prepared for this project.\n"
      );

      toast(
        "npm install complete."
      );

      return;
    }

    if (
      sub ===
      "start"
    ) {
      const npm =
        json(
          NPM_KEY,
          {}
        );

      if (
        !npm.installed
      ) {
        terminalPrint(
          "npm start: run 'npm install' first.\n"
        );

        return;
      }

      terminalPrint(
        "Starting project...\n"
      );

      showRunNotification();

      return;
    }

    if (
      sub ===
      "run"
    ) {
      terminalPrint(
        `npm run ${args.slice(1).join(" ") || "start"}: virtual script runner ready.\n`
      );

      return;
    }

    if (
      sub ===
      "init"
    ) {
      if (
        !Object.prototype.hasOwnProperty.call(
          studio.project.files,
          "/package.json"
        )
      ) {
        studio.project.files[
          "/package.json"
        ] =
          JSON.stringify(
            {
              name:
                studio.project.name
                  .toLowerCase()
                  .replace(
                    /[^a-z0-9]+/g,
                    "-"
                  ),
              version:"1.0.0",
              scripts:{
                start:"node server.js"
              }
            },
            null,
            2
          );

        saveDraft();
        renderTree();
      }

      terminalPrint(
        "package.json created.\n"
      );

      return;
    }

    if (
      sub ===
      "--version"
    ) {
      terminalPrint(
        "10.8.x (virtual npm environment)\n"
      );

      return;
    }

    terminalPrint(
      "npm: supported commands are install, start, run, init and --version.\n"
    );
  }

  function showRunNotification() {
    const existing =
