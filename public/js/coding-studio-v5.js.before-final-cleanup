    } catch {
      return fallback;
    }
  }

  function clone(value) {
    try {
      return structuredClone(value);
    } catch {
      return JSON.parse(
        JSON.stringify(value)
      );
    }
  }

  function normalizePath(path) {
    let value =
      String(path || "").trim();

    if (!value) {
      return "/";
    }

    value =
      value
        .replace(/\\/g, "/")
        .replace(/^\/+/, "/");

    if (!value.startsWith("/")) {
      value = `/${value}`;
    }

    const parts = [];

    value.split("/").forEach(part => {
      if (!part || part === ".") {
        return;
      }

      if (part === "..") {
        parts.pop();
        return;
      }

      parts.push(part);
    });

    return `/${parts.join("/")}`;
  }

  function parentPath(path) {
    const value =
      normalizePath(path);

    if (value === "/") {
      return "/";
    }

    const index =
      value.lastIndexOf("/");

    return index <= 0
      ? "/"
      : value.slice(0, index);
  }

  function baseName(path) {
    const value =
      normalizePath(path);

    if (value === "/") {
      return "/";
    }

    return value.slice(
      value.lastIndexOf("/") + 1
    );
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

