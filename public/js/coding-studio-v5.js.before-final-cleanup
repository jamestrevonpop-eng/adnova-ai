  function renderTree() {
    const tree =
      document.querySelector(
        "#adnova-v5-tree"
      );

    if (!tree) {
      return;
    }

    const folders =
      new Set(
        (
          studio.project.folders ||
          []
        ).map(
          normalizePath
        )
      );

    getFiles().forEach(
      file => {
        let parent =
          parentPath(file);

        while (
          parent !== "/"
        ) {
          folders.add(parent);
          parent =
            parentPath(parent);
        }
      }
    );

    tree.innerHTML = "";

    [...folders]
      .sort()
      .forEach(
        folder => {
          const row =
            document.createElement(
              "button"
            );

          row.className =
            "adnova-v5-tree-row folder";

          row.innerHTML =
            `<span>▸</span><span>${escapeHtml(
              baseName(folder)
            )}</span>`;

          row.addEventListener(
            "click",
            () =>
              terminalPrint(
                `${folder}\n`
              )
          );

          tree.appendChild(
            row
          );
        }
      );

    getFiles().forEach(
      file => {
        const row =
          document.createElement(
            "button"
          );

        row.className =
          `adnova-v5-tree-row ${
            file ===
            studio.project.currentFile
              ? "active"
              : ""
          }`;

        const extension =
          baseName(file)
            .split(".")
            .pop()
            .toLowerCase();

        let icon = "•";

        if (
          extension === "html"
        ) {
          icon = "◈";
        } else if (
          extension === "css"
        ) {
          icon = "◇";
        } else if (
          [
            "js",
            "ts"
          ].includes(
            extension
          )
        ) {
          icon = "◉";
        } else if (
          extension ===
          "md"
        ) {
          icon = "▤";
        }

        row.innerHTML =
          `<span>${icon}</span><span>${escapeHtml(
            baseName(file)
          )}</span>`;

        row.addEventListener(
          "click",
          () =>
            openFile(file)
        );

        tree.appendChild(
          row
        );
      }
    );
  }

  function openFile(path) {
    const value =
      normalizePath(path);

    if (
      !studio.project.files[
        value
      ] &&
      !Object.prototype.hasOwnProperty.call(
        studio.project.files,
        value
      )
    ) {
      toast(
        `File not found: ${value}`,
        "error"
      );

      return;
    }

    studio.project.currentFile =
      value;

    const root =
      document.getElementById(
        ROOT_ID
      );

    if (!root) {
      return;
    }

    root.querySelector(
      "#adnova-v5-path"
    ).textContent =
      value;

    const editor =
      root.querySelector(
        "#adnova-v5-code"
      );

    editor.value =
      studio.project.files[
        value
      ] || "";

    const extension =
      baseName(value)
        .split(".")
        .pop()
        .toLowerCase();

    editor.classList.toggle(
      "text-file",
      ["md","txt","json"].includes(
        extension
      )
    );

    renderTree();
    validateCurrentFile();
  }

