  function restoreSnapshot() {
    const snapshot =
      studio.project.snapshots?.[0];

    if (!snapshot) {
      toast(
        "No snapshot exists.",
        "error"
      );

      return;
    }

    studio.project.files =
      clone(
        snapshot.files
      );

    studio.project.folders =
      clone(
        snapshot.folders
      );

    saveDraft();

    renderTree();

    openFile(
      studio.project.currentFile ||
      "/index.html"
    );

    refreshPreview();

    toast(
      "Latest snapshot restored."
    );
